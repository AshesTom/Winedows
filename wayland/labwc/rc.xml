<?xml version="1.0"?>
<!--
  labwc's configuration for win4wine's Wayland session. The XP shell draws
  the desktop, the taskbar and the windows' frames; labwc keeps only what
  bridge-wm does on X11. Alt+Tab, the Windows key and Ctrl+Esc are handled
  for the XP shell by the compositor itself (src/win4wine.c).
-->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <!-- Wine's processes come and go; Xwayland stays for the session. -->
    <xwaylandPersistence>yes</xwaylandPersistence>
  </core>
  <theme>
    <font place="ActiveWindow"><size>9</size><weight>bold</weight></font>
    <font place="InactiveWindow"><size>9</size><weight>bold</weight></font>
  </theme>
  <!-- XP neither snaps nor tiles windows at screen edges; with "window_snap"
       in session.json, session.sh turns snapping on (range 1, topMaximize) -->
  <snapping>
    <range>0</range>
    <topMaximize>no</topMaximize>
  </snapping>
  <resistance>
    <screenEdgeStrength>0</screenEdgeStrength>
    <windowEdgeStrength>0</windowEdgeStrength>
  </resistance>
  <keyboard>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <!-- The media keys (Fn with the volume keys), as bridge-wm/hotkeys.py serves them on X11 -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="sh -c 'wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ || pactl set-sink-volume @DEFAULT_SINK@ +5%'" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="sh -c 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- || pactl set-sink-volume @DEFAULT_SINK@ -5%'" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="sh -c 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle'" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="sh -c 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle || pactl set-source-mute @DEFAULT_SOURCE@ toggle'" /></keybind>
    <keybind key="XF86AudioPlay"><action name="Execute" command="playerctl play-pause" /></keybind>
    <keybind key="XF86AudioNext"><action name="Execute" command="playerctl next" /></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute" command="playerctl previous" /></keybind>
  </keyboard>
  <mouse>
    <default />
  </mouse>
</labwc_config>
