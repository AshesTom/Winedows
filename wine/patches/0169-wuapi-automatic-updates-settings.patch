 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/wuaueng/main.c b/dlls/wuaueng/main.c
index 9783fe0..88dd323 100644
--- a/dlls/wuaueng/main.c
+++ b/dlls/wuaueng/main.c
@@ -20,6 +20,7 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winreg.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(wuaueng);
@@ -32,3 +33,28 @@ BOOL WINAPI WUCheckForUpdatesAtShutdown(DWORD flags)
     TRACE("(%#lx)\n", flags);
     return FALSE;
 }
+
+/* The options of Automatic Updates as XP's Automatic Updates applet
+ * (wuaucpl.cpl) reads them: SIZE is that of the structure it passes (0x2c,
+ * or 0x54 for the larger one), which begins with the option (AUOptions),
+ * the day and the hour of the scheduled installation; the rest (whether a
+ * policy sets them, and its own fields) stays zero. */
+HRESULT WINAPI GetAUOptionsEx(DWORD size, DWORD *options)
+{
+    static const WCHAR key[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update";
+    DWORD value, length;
+
+    TRACE("(%#lx, %p)\n", size, options);
+    if (!options || (size != 0x2c && size != 0x54)) return E_INVALIDARG;
+    memset(options, 0, size);
+    length = sizeof(value);
+    options[0] = !RegGetValueW(HKEY_LOCAL_MACHINE, key, L"AUOptions", RRF_RT_REG_DWORD | RRF_SUBKEY_WOW6464KEY,
+                               NULL, &value, &length) && value >= 1 && value <= 5 ? value : 2;
+    length = sizeof(value);
+    options[1] = !RegGetValueW(HKEY_LOCAL_MACHINE, key, L"ScheduledInstallDay", RRF_RT_REG_DWORD | RRF_SUBKEY_WOW6464KEY,
+                               NULL, &value, &length) && value <= 7 ? value : 0;
+    length = sizeof(value);
+    options[2] = !RegGetValueW(HKEY_LOCAL_MACHINE, key, L"ScheduledInstallTime", RRF_RT_REG_DWORD | RRF_SUBKEY_WOW6464KEY,
+                               NULL, &value, &length) && value < 24 ? value : 3;
+    return S_OK;
+}
diff --git a/dlls/wuaueng/wuaueng.spec b/dlls/wuaueng/wuaueng.spec
index dea3ee9..e58e388 100644
--- a/dlls/wuaueng/wuaueng.spec
+++ b/dlls/wuaueng/wuaueng.spec
@@ -1,4 +1,4 @@
-1 stub GetAUOptionsEx
+1 stdcall GetAUOptionsEx(long ptr)
 2 stub DSRunStoreAsComServer
 3 stub UHRunRemoteHandlerServer
 4 stdcall WUCheckForUpdatesAtShutdown(long)
