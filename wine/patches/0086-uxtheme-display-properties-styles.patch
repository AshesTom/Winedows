 dlls/uxtheme/msstyles.c   |  51 ++++++--
 dlls/uxtheme/msstyles.h   |   2 +
 dlls/uxtheme/system.c     | 257 ++++++++++++++++++++++++++++++++++++++
 dlls/uxtheme/uxtheme.spec |   7 +-
 5 files changed, 310 insertions(+), 19 deletions(-)

