+/***********************************************************************
+ *      MSSTYLES_FindThemeMetric
+ *
+ * Find a metric property for the theme file of a class, which need not be
+ * the active theme: XP's Display Properties read the colours, sizes and
+ * fonts of a style they switch to from one opened with OpenThemeDataFromFile.
+ */
+PTHEME_PROPERTY MSSTYLES_FindThemeMetric(HTHEME hTheme, int iPropertyPrimitive, int iPropertyId)
+{
+    PTHEME_CLASS tc = (PTHEME_CLASS)hTheme;
+
+    if(tc && tc->signature == THEME_CLASS_SIGNATURE && tc->tf)
+        return MSSTYLES_FFindMetric(tc->tf, iPropertyPrimitive, iPropertyId);
+    return MSSTYLES_FindMetric(iPropertyPrimitive, iPropertyId);
+}
