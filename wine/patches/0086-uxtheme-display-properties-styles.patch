diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
index 4eb7f9b..efaeca3 100644
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -891,6 +891,246 @@ HRESULT WINAPI GetThemeDocumentationProperty(LPCWSTR pszThemeName,
