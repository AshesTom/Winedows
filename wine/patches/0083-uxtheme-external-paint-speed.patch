diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index 6b7bb39..9095c57 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -122,6 +122,43 @@ static void external_shell_paint_nonclient( HWND hwnd, HRGN update )
     NtUserReleaseDC( hwnd, dc );
 }
 
+/* The default WM_NCPAINT's update region without the band that the Luna
+ * caption covers right after (uxtheme's Win4WineCaptionBand): the classic
+ * caption and its buttons were drawn there only to be painted over, at each
+ * step of a resize. The menu bar and the borders below stay. */
+static HRGN external_shell_classic_update( HWND hwnd, HRGN update )
+{
+    BOOL (WINAPI *caption_band)(HWND, RECT *);
+    HMODULE theme;
+    RECT band, window;
+    HRGN rest, caption;
+
+    if (!win4wine_external_shell() || !(theme = GetModuleHandleW( L"uxtheme.dll" )) ||
+        !(caption_band = (void *)GetProcAddress( theme, "Win4WineCaptionBand" )) ||
+        !caption_band( hwnd, &band ))
+        return update;
+    GetWindowRect( hwnd, &window );
+    OffsetRect( &band, window.left, window.top );
+    if (!(rest = CreateRectRgnIndirect( &window ))) return update;
+    if ((UINT_PTR)update > 1) CombineRgn( rest, update, NULL, RGN_COPY );
+    if (!(caption = CreateRectRgnIndirect( &band )))
+    {
+        DeleteObject( rest );
+        return update;
+    }
+    CombineRgn( rest, rest, caption, RGN_DIFF );
+    DeleteObject( caption );
+    return rest;
+}
+
+static LRESULT external_shell_classic_nc_paint( HWND hwnd, HRGN update, BOOL ansi )
+{
+    HRGN classic = external_shell_classic_update( hwnd, update );
+    LRESULT result = NtUserMessageCall( hwnd, WM_NCPAINT, (WPARAM)classic, 0, 0, NtUserDefWindowProc, ansi );
+    if (classic != update) DeleteObject( classic );
+    return result;
+}
+
 static LRESULT external_shell_nonclient_hit( HWND hwnd, LPARAM point, LRESULT original )
 {
     HMODULE theme;
@@ -380,6 +417,10 @@ LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam
             result = NtUserMessageCall( hwnd, msg, wParam, lParam, 0, NtUserDefWindowProc, TRUE );
         break;
 
+    case WM_NCPAINT:
+        result = external_shell_classic_nc_paint( hwnd, (HRGN)wParam, TRUE );
+        break;
+
     case WM_SYSCOMMAND:
         result = NC_HandleSysCommand( hwnd, wParam, lParam );
         break;
@@ -454,6 +495,10 @@ LRESULT WINAPI DefWindowProcW(
             result = NtUserMessageCall( hwnd, msg, wParam, lParam, 0, NtUserDefWindowProc, FALSE );
         break;
 
+    case WM_NCPAINT:
+        result = external_shell_classic_nc_paint( hwnd, (HRGN)wParam, FALSE );
+        break;
+
     case WM_SYSCOMMAND:
         result = NC_HandleSysCommand( hwnd, wParam, lParam );
         break;
