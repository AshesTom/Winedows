+/* A theme image of fewer bits per pixel as a 32-bpp one, with the bytes that
+ * every blit of it to a 32-bpp target converted it to (the fourth byte zero).
+ * The windows and the screen are 32 bpp; blitting the copy needs no
+ * conversion. Its default transparent colour was found before. */
+static HBITMAP screen_format_image(HBITMAP bmp)
+{
+    BITMAPINFO info = {{sizeof(info.bmiHeader)}};
+    DIBSECTION dib;
+    HBITMAP copy;
+    void *bits;
+    HDC hdc;
+    int lines;
+
+    if (!win4wine_external_shell() || !bmp || GetObjectW(bmp, sizeof(dib), &dib) != sizeof(dib) ||
+        dib.dsBm.bmBitsPixel >= 32 || dib.dsBmih.biCompression != BI_RGB)
+        return bmp;
+    info.bmiHeader.biWidth = dib.dsBmih.biWidth;
+    info.bmiHeader.biHeight = dib.dsBmih.biHeight;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(copy = CreateDIBSection(NULL, &info, DIB_RGB_COLORS, &bits, NULL, 0))) return bmp;
+    hdc = CreateCompatibleDC(NULL);
+    lines = GetDIBits(hdc, bmp, 0, abs(dib.dsBmih.biHeight), bits, &info, DIB_RGB_COLORS);
+    DeleteDC(hdc);
+    if (lines != abs(dib.dsBmih.biHeight))
+    {
+        DeleteObject(copy);
+        return bmp;
+    }
+    DeleteObject(bmp);
+    return copy;
+}
