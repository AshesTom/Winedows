+    const WINDOWPOS *pos = (const WINDOWPOS *)lparam;
+    return msg == WM_WINDOWPOSCHANGED && !(pos->flags & (SWP_FRAMECHANGED | SWP_SHOWWINDOW | SWP_HIDEWINDOW));
