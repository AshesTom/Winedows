     return (int)(((2LL * d + 1) * src + 2LL * dst - 1) / (2LL * dst)) - 1;
 }
 
+/* A target whose pixels have no alpha of their own: a window's DC on a 32-bpp
+ * screen, without a mapping. A colour key there is an alpha of 0 or 255. */
+static BOOL keyed_blend_target(HDC hdc)
+{
+    return GetObjectType(hdc) == OBJ_DC && GetDeviceCaps(hdc, BITSPIXEL) == 32 &&
+           GetMapMode(hdc) == MM_TEXT && GetGraphicsMode(hdc) == GM_COMPATIBLE && !GetLayout(hdc);
+}
+
 static BOOL xp_stretch(HDC hdcDst, int x, int y, int width, int height, HDC hdcSrc, int xs, int ys,
                        int src_width, int src_height, INT transparent, COLORREF transcolor)
 {
@@ -416,8 +424,10 @@ static BOOL xp_stretch(HDC hdcDst, int x, int y, int width, int height, HDC hdcS
     int *columns = NULL, i, j;
     BOOL ret = FALSE;
 
-    /* The part is copied once in 32 bpp, which converts it as a blit of each
-     * column and row would, and then picked pixel by pixel. */
+    /* The part is copied once in 32 bpp, which converts it as each of the
+     * columns and rows copied from it would be, and then picked pixel by
+     * pixel: the copies of single columns of an enlarged part took as many
+     * blits as the frame is wide. */
     info.bmiHeader.biPlanes = 1;
     info.bmiHeader.biBitCount = 32;
     info.bmiHeader.biWidth = src_width;
@@ -438,7 +448,19 @@ static BOOL xp_stretch(HDC hdcDst, int x, int y, int width, int height, HDC hdcS
         const DWORD *line = source_bits + xp_stretch_source(j, src_height, height) * src_width;
         for (i = 0; i < width; i++) row_bits[j * width + i] = line[columns[i]];
     }
-    ret = UXTHEME_StretchBlt(hdcDst, x, y, width, height, rows, 0, 0, width, height, transparent, transcolor);
+    if (transparent == ALPHABLEND_BINARY && keyed_blend_target(hdcDst))
+    {
+        /* What TransparentBlt leaves in such a target, in one blend instead
+         * of its masks and temporary bitmaps: the key colour's pixels keep
+         * the target's, the others are copied. */
+        static const BLENDFUNCTION blend = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+        DWORD key = GetRValue(transcolor) << 16 | GetGValue(transcolor) << 8 | GetBValue(transcolor);
+        for (i = 0; i < width * height; i++)
+            row_bits[i] = (row_bits[i] & 0xffffff) == key ? 0 : row_bits[i] | 0xff000000;
+        ret = GdiAlphaBlend(hdcDst, x, y, width, height, rows, 0, 0, width, height, blend);
+    }
+    else
+        ret = UXTHEME_StretchBlt(hdcDst, x, y, width, height, rows, 0, 0, width, height, transparent, transcolor);
 done:
     free(columns);
     if (old_source) SelectObject(source, old_source);
