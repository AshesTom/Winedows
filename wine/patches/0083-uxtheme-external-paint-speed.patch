 struct caption_region
 {
+    struct list entry;
+    HWND hwnd;
     WNDPROC original;
     HRGN managed;
     BOOL updating, abandoned;
 };
 
+/* The windows shaped here, kept in the process: the subclass looks its
+ * window up for every message, and a window property would ask wineserver
+ * each time. Only this process's windows are shaped. */
+static struct list regions = LIST_INIT(regions);
+static CRITICAL_SECTION regions_section;
+static CRITICAL_SECTION_DEBUG regions_section_debug =
+{
+    0, 0, &regions_section,
+    { &regions_section_debug.ProcessLocksList, &regions_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": regions_section") }
+};
+static CRITICAL_SECTION regions_section = { &regions_section_debug, -1, 0, 0, 0, 0 };
+
+static struct caption_region *find_region(HWND hwnd)
+{
+    struct caption_region *region, *found = NULL;
+    EnterCriticalSection(&regions_section);
+    LIST_FOR_EACH_ENTRY(region, &regions, struct caption_region, entry)
+        if (region->hwnd == hwnd) { found = region; break; }
+    LeaveCriticalSection(&regions_section);
+    return found;
+}
+
+static void add_region(struct caption_region *region)
+{
+    EnterCriticalSection(&regions_section);
+    list_add_head(&regions, &region->entry);
+    LeaveCriticalSection(&regions_section);
+}
+
+static void remove_region(struct caption_region *region)
+{
+    EnterCriticalSection(&regions_section);
+    list_remove(&region->entry);
+    LeaveCriticalSection(&regions_section);
+}
