+/* The band at the top of the window, in window coordinates, that
+ * Win4WineDrawNonClient covers with the caption image; FALSE when it would
+ * draw no caption. user32 leaves the band out of the classic WM_NCPAINT,
+ * whose caption and buttons were painted only to be painted over. */
+BOOL WINAPI Win4WineCaptionBand(HWND hwnd, RECT *band)
+{
+    DWORD style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
+    RECT window, client, buttons[3];
+    POINT origin = {0, 0};
+    HTHEME theme;
+    int border_y;
+
+    if (!win4wine_external_shell() || (style & WS_CAPTION) != WS_CAPTION || (style & WS_CHILD) ||
+        (exstyle & WS_EX_TOOLWINDOW) || !IsThemeActive())
+        return FALSE;
+    if (!(theme = OpenThemeDataForDpi(NULL, L"Window", GetDpiForWindow(hwnd)))) return FALSE;
+    GetWindowRect(hwnd, &window);
+    GetClientRect(hwnd, &client);
+    ClientToScreen(hwnd, &origin);
+    OffsetRect(&client, origin.x - window.left, origin.y - window.top);
+    border_y = GetSystemMetrics(style & WS_THICKFRAME ? SM_CYFRAME : SM_CYDLGFRAME);
+    themed_caption_geometry(hwnd, theme, band, buttons);
+    /* As draw_non_client stretches the caption image. */
+    band->bottom = max(band->bottom, min(border_y + GetSystemMetrics(SM_CYCAPTION), client.top));
+    CloseThemeData(theme);
+    return TRUE;
+}
