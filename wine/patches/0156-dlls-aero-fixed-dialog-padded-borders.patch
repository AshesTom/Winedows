 static BOOL aero_frames(void);
+static int themed_frame_border(HWND hwnd, DWORD style, BOOL vertical);
 static HRGN aero_frame_region(int width, int height, BOOL maximized);
 BOOL WINAPI Win4WineDrawNonClient(HWND hwnd, HDC target);
 static BOOL draw_non_client(HWND hwnd, HDC target, BOOL paint);
@@ -370,7 +371,7 @@
