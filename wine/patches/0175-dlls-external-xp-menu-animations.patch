 dlls/winewayland.drv/window_surface.c | 107 ++++++++++++++++++++++++++++++++++++++++--
 dlls/win32u/win32u_private.h |   1 +
 dlls/win32u/sysparams.c |   8 ++++++++
 dlls/win32u/message.c |   3 +++
 10 files changed, 512 insertions(+), 18 deletions(-)

diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -30,6 +30,7 @@
 #include "wine/debug.h"
 #include "wine/win4wine.h"
 #include "vssym32.h"
+#include "winternl.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(menu);
 WINE_DECLARE_DEBUG_CHANNEL(accel);
@@ -3503,6 +3504,74 @@
     NtUserReleaseDC( 0, hdc );
 }
 
+/* XP's menu fade without a compositing manager: show the menu over a copy of
+ * the screen it covers, more opaque at each frame, for XP's 175 ms. The window
+ * stays opaque, so nothing shows through it but these frames. */
+static BOOL fade_popup_menu( HWND hwnd, HMENU hmenu, int x, int y, int width, int height )
+{
+    static const DWORD duration = 175; /* XP's CMS_MENUFADE */
+    HDC screen, hdc, under = 0, image = 0, frame = 0;
+    HBITMAP under_bitmap = 0, image_bitmap = 0, frame_bitmap = 0;
+    LARGE_INTEGER delay;
+    DWORD start, elapsed;
+    BOOL ret = FALSE;
+
+    if (width <= 0 || height <= 0) return FALSE;
+    if (!(screen = NtUserGetDCEx( 0, 0, DCX_CACHE | DCX_WINDOW ))) return FALSE;
+    if ((under = NtGdiCreateCompatibleDC( screen )) && (image = NtGdiCreateCompatibleDC( screen )) &&
+        (frame = NtGdiCreateCompatibleDC( screen )) &&
+        (under_bitmap = NtGdiCreateCompatibleBitmap( screen, width, height )) &&
+        (image_bitmap = NtGdiCreateCompatibleBitmap( screen, width, height )) &&
+        (frame_bitmap = NtGdiCreateCompatibleBitmap( screen, width, height )))
+    {
+        NtGdiSelectBitmap( under, under_bitmap );
+        NtGdiSelectBitmap( image, image_bitmap );
+        NtGdiSelectBitmap( frame, frame_bitmap );
+        ret = NtGdiBitBlt( under, 0, 0, width, height, screen, x, y, SRCCOPY, 0, 0 );
+    }
+    NtUserReleaseDC( 0, screen );
+
+    if (ret)
+    {
+        draw_popup_menu( hwnd, image, hmenu );
+        /* the first frame is the screen alone: with SWP_NOREDRAW, the external
+         * shell's X11 driver keeps what the screen shows under the new popup,
+         * where the window would be black until its first frame. The menu's
+         * own painting waits until the end. */
+        NtUserSetWindowPos( hwnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_SHOWWINDOW | SWP_NOACTIVATE |
+                            SWP_NOMOVE | SWP_NOSIZE | SWP_NOREDRAW | SWP_DEFERERASE );
+        if ((hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_WINDOW )))
+        {
+            delay.QuadPart = -100000; /* 10 ms */
+            start = NtGetTickCount();
+            do
+            {
+                BLENDFUNCTION blend = { AC_SRC_OVER, 0, 0, 0 };
+
+                elapsed = min( NtGetTickCount() - start, duration );
+                blend.SourceConstantAlpha = elapsed * 255 / duration;
+                NtGdiBitBlt( frame, 0, 0, width, height, under, 0, 0, SRCCOPY, 0, 0 );
+                NtGdiAlphaBlend( frame, 0, 0, width, height, image, 0, 0, width, height,
+                                 *(DWORD *)&blend, 0 );
+                NtGdiBitBlt( hdc, 0, 0, width, height, frame, 0, 0, SRCCOPY, 0, 0 );
+                /* show this frame now: the thread reaches no message loop until the end */
+                flush_window_surfaces( TRUE );
+                if (elapsed < duration) NtDelayExecution( FALSE, &delay );
+            } while (elapsed < duration);
+            NtUserReleaseDC( hwnd, hdc );
+        }
+        NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_UPDATENOW | RDW_ALLCHILDREN );
+    }
+
+    if (frame) NtGdiDeleteObjectApp( frame );
+    if (image) NtGdiDeleteObjectApp( image );
+    if (under) NtGdiDeleteObjectApp( under );
+    if (frame_bitmap) NtGdiDeleteObjectApp( frame_bitmap );
+    if (image_bitmap) NtGdiDeleteObjectApp( image_bitmap );
+    if (under_bitmap) NtGdiDeleteObjectApp( under_bitmap );
+    return ret;
+}
+
 static BOOL show_popup( HWND owner, HMENU hmenu, UINT id, UINT flags,
                         int x, int y, INT xanchor, INT yanchor )
 {
@@ -3510,6 +3579,9 @@
     MONITORINFO info;
     UINT max_height;
     RECT rect;
+    BOOL animate = FALSE, fade = FALSE, ui_effects = FALSE;
+    BOOL layered = FALSE, blend = FALSE;
+    DWORD exstyle = 0;
 
     TRACE( "owner=%p hmenu=%p id=0x%04x x=0x%04x y=0x%04x xa=0x%04x ya=0x%04x\n",
            owner, hmenu, id, x, y, xanchor, yanchor );
@@ -3554,16 +3626,117 @@
     }
     if (y < info.rcWork.top) y = info.rcWork.top;
 
+    /* XP's USER menu window checks both the menu-animation and UI-effects
+     * preferences. If MenuFade is set, it blends the popup for 175 ms;
+     * otherwise it reveals the popup from the edge it opened from. */
+    if (win4wine_shell() == WIN4WINE_SHELL_XP && !(flags & TPM_NOANIMATION) && !menu_keyboard_mode &&
+        NtUserSystemParametersInfo( SPI_GETMENUANIMATION, 0, &animate, 0 ) && animate &&
+        NtUserSystemParametersInfo( SPI_GETUIEFFECTS, 0, &ui_effects, 0 ) && ui_effects)
+    {
+        NtUserSystemParametersInfo( SPI_GETMENUFADE, 0, &fade, 0 );
+        animate = TRUE;
+    }
+    else animate = FALSE;
+
+    if (animate && fade && !getenv( "WIN4WINE_COMPOSITED" ))
+    {
+        /* Without a compositing manager, window opacity can't show what is
+         * underneath. Blend the menu with the screen it covers instead. */
+        blend = TRUE;
+    }
+    else if (animate && fade)
+    {
+        exstyle = NtUserGetWindowLongW( menu->hWnd, GWL_EXSTYLE );
+        layered = !(exstyle & WS_EX_LAYERED);
+        if (layered) NtUserSetWindowLong( menu->hWnd, GWL_EXSTYLE, exstyle | WS_EX_LAYERED, FALSE );
+        if (!NtUserSetLayeredWindowAttributes( menu->hWnd, 0, 0, LWA_ALPHA ))
+        {
+            if (layered) NtUserSetWindowLong( menu->hWnd, GWL_EXSTYLE, exstyle, FALSE );
+            animate = FALSE;
+        }
+    }
+    else if (animate)
+    {
+        HRGN empty = NtGdiCreateRectRgn( 0, 0, 0, 0 );
+        if (!empty || !NtUserSetWindowRgn( menu->hWnd, empty, FALSE ))
+        {
+            if (empty) NtGdiDeleteObjectApp( empty );
+            animate = FALSE;
+        }
+    }
+
     if (!top_popup)
     {
         top_popup = menu->hWnd;
         top_popup_hmenu = hmenu;
     }
 
+    if (blend)
+    {
+        /* size the hidden window, so the menu can draw before it shows */
+        NtUserSetWindowPos( menu->hWnd, HWND_TOPMOST, x, y, menu->Width, menu->Height,
+                            SWP_NOACTIVATE | SWP_NOREDRAW );
+        if (!fade_popup_menu( menu->hWnd, hmenu, x, y, menu->Width, menu->Height ))
+            blend = animate = FALSE;
+    }
     /* Display the window */
-    NtUserSetWindowPos( menu->hWnd, HWND_TOPMOST, x, y, menu->Width, menu->Height,
-                        SWP_SHOWWINDOW | SWP_NOACTIVATE );
-    NtUserRedrawWindow( menu->hWnd, NULL, 0, RDW_UPDATENOW | RDW_ALLCHILDREN );
+    if (!blend)
+    {
+        NtUserSetWindowPos( menu->hWnd, HWND_TOPMOST, x, y, menu->Width, menu->Height,
+                            SWP_SHOWWINDOW | SWP_NOACTIVATE );
+        NtUserRedrawWindow( menu->hWnd, NULL, 0, RDW_UPDATENOW | RDW_ALLCHILDREN );
+    }
+
+    if (animate && fade && !blend)
+    {
+        LARGE_INTEGER delay;
+        unsigned int i;
+
+        delay.QuadPart = -175000; /* XP's CMS_MENUFADE is 175 ms. */
+        for (i = 1; i <= 10; i++)
+        {
+            NtUserSetLayeredWindowAttributes( menu->hWnd, 0, i * 255 / 10, LWA_ALPHA );
+            NtUserRedrawWindow( menu->hWnd, NULL, 0, RDW_INVALIDATE | RDW_UPDATENOW | RDW_ALLCHILDREN );
+            /* show this frame now: the thread reaches no message loop until the end */
+            flush_window_surfaces( TRUE );
+            NtDelayExecution( FALSE, &delay );
+        }
+        NtUserSetLayeredWindowAttributes( menu->hWnd, 0, 255, LWA_ALPHA );
+        if (layered) NtUserSetWindowLong( menu->hWnd, GWL_EXSTYLE, exstyle, FALSE );
+    }
+    else if (animate && !fade)
+    {
+        LARGE_INTEGER delay;
+        BOOL from_right = !!(flags & TPM_RIGHTALIGN);
+        BOOL from_bottom = !!(flags & TPM_BOTTOMALIGN);
+        BOOL animate_horiz = !!(flags & (TPM_HORPOSANIMATION | TPM_HORNEGANIMATION));
+        BOOL animate_vert = !!(flags & (TPM_VERPOSANIMATION | TPM_VERNEGANIMATION));
+        BOOL directional = animate_horiz || animate_vert;
+        unsigned int i, frames = 11;
+        INT width = menu->Width, height = menu->Height;
+
+        if (flags & TPM_HORPOSANIMATION) from_right = FALSE;
+        else if (flags & TPM_HORNEGANIMATION) from_right = TRUE;
+        if (flags & TPM_VERPOSANIMATION) from_bottom = FALSE;
+        else if (flags & TPM_VERNEGANIMATION) from_bottom = TRUE;
+        delay.QuadPart = -1500000 / frames;
+        for (i = 1; i <= frames; i++)
+        {
+            INT cx = !directional || animate_horiz ? max( 1, width * i / frames ) : width;
+            INT cy = !directional || animate_vert ? max( 1, height * i / frames ) : height;
+            HRGN region = NtGdiCreateRectRgn( from_right ? width - cx : 0,
+                                             from_bottom ? height - cy : 0,
+                                             from_right ? width : cx,
+                                             from_bottom ? height : cy );
+            if (region && !NtUserSetWindowRgn( menu->hWnd, region, TRUE )) NtGdiDeleteObjectApp( region );
+            NtUserRedrawWindow( menu->hWnd, NULL, 0, RDW_INVALIDATE | RDW_UPDATENOW | RDW_ALLCHILDREN );
+            /* show this frame now: the thread reaches no message loop until the end */
+            flush_window_surfaces( TRUE );
+            NtDelayExecution( FALSE, &delay );
+        }
+        NtUserSetWindowRgn( menu->hWnd, 0, TRUE );
+        NtUserRedrawWindow( menu->hWnd, NULL, 0, RDW_INVALIDATE | RDW_UPDATENOW | RDW_ALLCHILDREN );
+    }
     return TRUE;
 }
 
diff --git a/dlls/user32/win.c b/dlls/user32/win.c
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -874,17 +874,114 @@
  */
 BOOL WINAPI AnimateWindow( HWND hwnd, DWORD time, DWORD flags )
 {
-    FIXME( "partial stub\n" );
-
-    /* If trying to show/hide and it's already shown/hidden or invalid window,
-     * fail with invalid parameter. */
-    if (!IsWindow( hwnd ) || (!(flags & AW_HIDE)) == IsWindowVisible( hwnd ))
-    {
-        SetLastError(ERROR_INVALID_PARAMETER);
+    BOOL hide = !!(flags & AW_HIDE), visible, layered, has_layered_attrs = FALSE;
+    DWORD exstyle, old_flags = 0;
+    BYTE old_alpha = 255;
+    COLORREF old_key = 0;
+    unsigned int frames, i;
+
+    if (win4wine_shell() != WIN4WINE_SHELL_XP)
+    {
+        FIXME( "partial stub\n" );
+        /* If trying to show/hide and it's already shown/hidden or invalid window,
+         * fail with invalid parameter. */
+        if (!IsWindow( hwnd ) || (!hide) == IsWindowVisible( hwnd ))
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        NtUserShowWindow( hwnd, hide ? SW_HIDE : ((flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA) );
+        return TRUE;
+    }
+
+    visible = IsWindowVisible( hwnd );
+    if (!IsWindow( hwnd ) || (!hide) == visible)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
     }
 
-    NtUserShowWindow( hwnd, (flags & AW_HIDE) ? SW_HIDE : ((flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA) );
+    if (!time) time = 200;
+    frames = min( max( time / 10, 1 ), 30 );
+    exstyle = GetWindowLongW( hwnd, GWL_EXSTYLE );
+    layered = !!(exstyle & WS_EX_LAYERED);
+    if (layered) has_layered_attrs = NtUserGetLayeredWindowAttributes( hwnd, &old_key, &old_alpha, &old_flags );
+
+    if (flags & AW_BLEND)
+    {
+        if (!layered) SetWindowLongW( hwnd, GWL_EXSTYLE, exstyle | WS_EX_LAYERED );
+        if (!hide)
+        {
+            NtUserSetLayeredWindowAttributes( hwnd, 0, 0, LWA_ALPHA );
+            if (!visible) NtUserShowWindow( hwnd, (flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA );
+        }
+        else NtUserSetLayeredWindowAttributes( hwnd, 0, 255, LWA_ALPHA );
+
+        for (i = 1; i <= frames; i++)
+        {
+            BYTE alpha = hide ? 255 - i * 255 / frames : i * 255 / frames;
+            NtUserSetLayeredWindowAttributes( hwnd, 0, alpha, LWA_ALPHA );
+            NtUserRedrawWindow( hwnd, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_UPDATENOW | RDW_ALLCHILDREN );
+            MsgWaitForMultipleObjects( 0, NULL, FALSE, time / frames, 0 );
+        }
+        if (hide) NtUserShowWindow( hwnd, SW_HIDE );
+        if (layered)
+        {
+            if (has_layered_attrs) NtUserSetLayeredWindowAttributes( hwnd, old_key, old_alpha, old_flags );
+            else NtUserSetLayeredWindowAttributes( hwnd, old_key, 255, LWA_ALPHA );
+        }
+        else SetWindowLongW( hwnd, GWL_EXSTYLE, exstyle );
+        return TRUE;
+    }
+
+    if (flags & AW_SLIDE)
+    {
+        RECT window;
+        HRGN current;
+        int width, height;
+        BOOL right_to_left = !!(flags & AW_HOR_NEGATIVE);
+        BOOL bottom_to_top = !!(flags & AW_VER_NEGATIVE);
+        BOOL animate_horiz = !!(flags & (AW_HOR_POSITIVE | AW_HOR_NEGATIVE));
+        BOOL animate_vert = !!(flags & (AW_VER_POSITIVE | AW_VER_NEGATIVE));
+
+        if ((flags & AW_CENTER) || (!animate_horiz && !animate_vert))
+            animate_horiz = animate_vert = TRUE;
+
+        current = CreateRectRgn( 0, 0, 0, 0 );
+        if (current && GetWindowRgn( hwnd, current ) != ERROR)
+        {
+            DeleteObject( current );
+            current = NULL; /* Preserve an application's existing window shape. */
+        }
+        if (current && GetWindowRect( hwnd, &window ))
+        {
+            width = window.right - window.left;
+            height = window.bottom - window.top;
+            if (!hide) NtUserSetWindowRgn( hwnd, CreateRectRgn( 0, 0, 0, 0 ), FALSE );
+            if (!visible) NtUserShowWindow( hwnd, (flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA );
+
+            for (i = 1; i <= frames; i++)
+            {
+                int cx = animate_horiz ? (hide ? width * (frames - i) / frames : max( 1, width * i / frames )) : width;
+                int cy = animate_vert ? (hide ? height * (frames - i) / frames : max( 1, height * i / frames )) : height;
+                int left = (flags & AW_CENTER) ? (width - cx) / 2 : (right_to_left ? width - cx : 0);
+                int top = (flags & AW_CENTER) ? (height - cy) / 2 : (bottom_to_top ? height - cy : 0);
+                HRGN region = CreateRectRgn( left, top, left + cx, top + cy );
+                if (region && !NtUserSetWindowRgn( hwnd, region, TRUE )) DeleteObject( region );
+                NtUserRedrawWindow( hwnd, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW | RDW_ALLCHILDREN );
+                MsgWaitForMultipleObjects( 0, NULL, FALSE, time / frames, 0 );
+            }
+
+            if (hide) NtUserShowWindow( hwnd, SW_HIDE );
+            NtUserSetWindowRgn( hwnd, NULL, TRUE );
+            DeleteObject( current );
+            return TRUE;
+        }
+        if (current) DeleteObject( current );
+    }
+
+    if (!hide && !visible) NtUserShowWindow( hwnd, (flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA );
+    else if (hide) NtUserShowWindow( hwnd, SW_HIDE );
     return TRUE;
 }
 
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -683,7 +683,75 @@
 /***********************************************************************
  *              sync_window_opacity
  */
-static void sync_window_opacity( Display *display, Window win, BYTE alpha, DWORD flags )
+static void sync_layered_window_shape( struct x11drv_win_data *data, BYTE alpha, DWORD flags )
+{
+#ifdef HAVE_LIBXSHAPE
+    static const BYTE matrix[8][8] =
+    {
+        { 0,48,12,60, 3,51,15,63 }, {32,16,44,28,35,19,47,31},
+        { 8,56, 4,52,11,59, 7,55}, {40,24,36,20,43,27,39,23},
+        { 2,50,14,62, 1,49,13,61}, {34,18,46,30,33,17,45,29},
+        {10,58, 6,54, 9,57, 5,53}, {42,26,38,22,41,25,37,21}
+    };
+    Display *display;
+    XWindowAttributes attr;
+    Pixmap mask, stipple;
+    GC gc;
+    BYTE bits[8];
+    unsigned int x, y, level;
+
+    if (!data || data->shaped || !data->whole_window || win4wine_shell() != WIN4WINE_SHELL_XP) return;
+    display = data->display;
+
+    /* EWMH opacity needs a compositing manager. In the XP session's nested
+     * X server there isn't one, so use an ordered-dither shape as the
+     * equivalent visible opacity for XP's 175 ms menu fade. */
+    if (flags & LWA_ALPHA)
+    {
+        char selection[32];
+        Atom compositor;
+        snprintf( selection, sizeof(selection), "_NET_WM_CM_S%d", DefaultScreen(display) );
+        compositor = XInternAtom( display, selection, False );
+        if (XGetSelectionOwner( display, compositor ) == None)
+        {
+            if (!XGetWindowAttributes( display, data->whole_window, &attr )) return;
+            if (!alpha) level = 0;
+            else level = (alpha * 64 + 254) / 255;
+            for (y = 0; y < 8; y++)
+            {
+                bits[y] = 0;
+                for (x = 0; x < 8; x++) if (matrix[y][x] < level) bits[y] |= 1 << x;
+            }
+            mask = XCreatePixmap( display, data->whole_window, attr.width, attr.height, 1 );
+            stipple = XCreateBitmapFromData( display, data->whole_window, (const char *)bits, 8, 8 );
+            if (!mask || !stipple)
+            {
+                if (mask) XFreePixmap( display, mask );
+                if (stipple) XFreePixmap( display, stipple );
+                return;
+            }
+            gc = XCreateGC( display, mask, 0, NULL );
+            XSetForeground( display, gc, 1 );
+            XSetBackground( display, gc, 0 );
+            XSetFillStyle( display, gc, FillOpaqueStippled );
+            XSetStipple( display, gc, stipple );
+            XFillRectangle( display, mask, gc, 0, 0, attr.width, attr.height );
+            XShapeCombineMask( display, data->whole_window, ShapeBounding, 0, 0, mask, ShapeSet );
+            XFreeGC( display, gc );
+            XFreePixmap( display, stipple );
+            XFreePixmap( display, mask );
+            return;
+        }
+    }
+
+    /* Clear the temporary opacity shape after the fade, or when a compositor
+     * takes over. This function leaves application window regions untouched. */
+    XShapeCombineMask( display, data->whole_window, ShapeBounding, 0, 0, None, ShapeSet );
+#endif
+}
+
+static void sync_window_opacity( struct x11drv_win_data *data, Display *display, Window win,
+                                 BYTE alpha, DWORD flags )
 {
     unsigned long opacity = 0xffffffff;
 
@@ -694,6 +762,8 @@
     else
         XChangeProperty( display, win, x11drv_atom(_NET_WM_WINDOW_OPACITY),
                          XA_CARDINAL, 32, PropModeReplace, (unsigned char *)&opacity, 1 );
+
+    sync_layered_window_shape( data, alpha, flags );
 }
 
 
@@ -2708,7 +2778,7 @@
 
