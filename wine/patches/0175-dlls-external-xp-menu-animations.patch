+/* Wayland surfaces blend their premultiplied alpha. Apply the constant
+ * opacity from SetLayeredWindowAttributes to the changed pixels so XP menu
+ * fades work without a compositor-specific window opacity protocol. */
+static void wayland_shm_buffer_apply_alpha(struct wayland_shm_buffer *buffer, HRGN region, BYTE alpha)
+{
+    RGNDATA *data;
+    DWORD size;
+    RECT *rects;
+    unsigned int i;
+
+    if (alpha == 255 || !(size = NtGdiGetRegionData(region, 0, NULL))) return;
+    if (!(data = malloc(size))) return;
+    if (!NtGdiGetRegionData(region, size, data))
+    {
+        free(data);
+        return;
+    }
+
+    rects = (RECT *)data->Buffer;
+    for (i = 0; i < data->rdh.nCount; i++)
+    {
+        int left = max(rects[i].left, 0), top = max(rects[i].top, 0);
+        int right = min(rects[i].right, buffer->width), bottom = min(rects[i].bottom, buffer->height);
+        int x, y;
+
+        for (y = top; y < bottom; y++)
+        {
+            UINT32 *pixel = (UINT32 *)buffer->map_data + y * buffer->width + left;
+            for (x = left; x < right; x++, pixel++)
+            {
+                BYTE a = (*pixel >> 24) * alpha / 255;
+                if (!a) *pixel = 0;
+                else *pixel = (a << 24) | (((*pixel >> 16) & 0xff) * alpha / 255 << 16) |
+                              (((*pixel >> 8) & 0xff) * alpha / 255 << 8) |
+                              ((*pixel & 0xff) * alpha / 255);
+            }
+        }
+    }
+    free(data);
+}
+
+static void wayland_shm_buffer_apply_region(struct wayland_shm_buffer *buffer, HRGN region)
+{
+    RGNDATA *data;
+    BYTE *mask;
+    DWORD size;
+    RECT *rects;
+    unsigned int i, x, y;
+    UINT32 *pixels = buffer->map_data;
+
+    if (!region || !(size = NtGdiGetRegionData(region, 0, NULL))) return;
+    if (!(data = malloc(size))) return;
+    if (!NtGdiGetRegionData(region, size, data))
+    {
+        free(data);
+        return;
+    }
+    if (!(mask = calloc((size_t)buffer->width * buffer->height, 1)))
+    {
+        free(data);
+        return;
+    }
+
+    rects = (RECT *)data->Buffer;
+    for (i = 0; i < data->rdh.nCount; i++)
+    {
+        int left = max(rects[i].left, 0), top = max(rects[i].top, 0);
+        int right = min(rects[i].right, buffer->width), bottom = min(rects[i].bottom, buffer->height);
+        for (y = top; y < bottom; y++) memset(mask + y * buffer->width + left, 1, right - left);
+    }
+
+    for (i = 0; i < (unsigned int)buffer->width * buffer->height; i++)
+        if (!mask[i]) pixels[i] = 0;
+
+    free(mask);
+    free(data);
+}
