+/***********************************************************************
+ *           CheckElevationEnabled   (KERNEL32.@)
+ *
+ * There is no User Account Control here.
+ */
+DWORD WINAPI CheckElevationEnabled( BOOL *enabled )
+{
+    if (!enabled) return ERROR_INVALID_PARAMETER;
+    *enabled = FALSE;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *           CheckElevation   (KERNEL32.@)
+ */
+DWORD WINAPI CheckElevation( const WCHAR *name, DWORD *flags, HANDLE token, DWORD *run_level, DWORD *reason )
+{
+    FIXME( "%s %p %p %p %p: no elevation\n", debugstr_w(name), flags, token, run_level, reason );
+    if (run_level) *run_level = 0;
+    if (reason) *reason = 0;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *           GetDurationFormat   (KERNEL32.@)
+ *
+ * Only the default format (hours:minutes:seconds) of a duration in 100ns units.
+ */
+int WINAPI GetDurationFormat( LCID lcid, DWORD flags, const SYSTEMTIME *time, ULONGLONG duration,
+                              const WCHAR *format, WCHAR *buffer, int size )
+{
+    WCHAR text[64];
+    ULONGLONG seconds;
+    int len;
+
+    FIXME( "%04lx %lx %p %s %s: default format only\n", lcid, flags, time,
+           wine_dbgstr_longlong(duration), debugstr_w(format) );
+    if (time) seconds = time->wHour * 3600 + time->wMinute * 60 + time->wSecond;
+    else seconds = duration / 10000000;
+    len = swprintf( text, ARRAY_SIZE(text), L"%I64u:%02u:%02u", seconds / 3600,
+                    (unsigned int)(seconds / 60 % 60), (unsigned int)(seconds % 60) ) + 1;
+    if (!buffer || !size) return len;
+    if (size < len)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return 0;
+    }
+    memcpy( buffer, text, len * sizeof(WCHAR) );
+    return len;
+}
+
+/***********************************************************************
+ *           WerpNotifyUseStringResource   (KERNEL32.@)
+ *
+ * Windows 7's shell32 and comctl32 call it; there is no Windows Error
+ * Reporting here. Its arguments have no public description: on 64-bit the
+ * caller passes them in registers and removes them itself, so returning
+ * without reading them is safe.
+ */
+DWORD WINAPI WerpNotifyUseStringResource(void)
+{
+    return 0;
+}
