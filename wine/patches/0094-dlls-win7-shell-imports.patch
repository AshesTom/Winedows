+/******************************************************************************
+ * LoadStringByReference (kernelbase.@)
+ *
+ * Load the string that "@[path\\]dll,-id" names; any other text is the string itself.
+ */
+BOOL WINAPI LoadStringByReference( DWORD flags, const WCHAR *language, const WCHAR *source, WCHAR *buffer,
+                                   ULONG size, const WCHAR *directory, ULONG *needed )
+{
+    WCHAR *expanded, *comma, path[MAX_PATH];
+    DWORD len;
+    LONG result;
+    INT req = 0;
+
+    TRACE( "%#lx %s %s %p %lu %s %p\n", flags, debugstr_w(language), debugstr_w(source), buffer, size,
+           debugstr_w(directory), needed );
+    if (!source || (!buffer && size))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (*source != '@')
+    {
+        len = lstrlenW( source ) + 1;
+        if (needed) *needed = len;
+        if (!buffer || size < len)
+        {
+            SetLastError( ERROR_MORE_DATA );
+            return FALSE;
+        }
+        memcpy( buffer, source, len * sizeof(WCHAR) );
+        return TRUE;
+    }
+    if (!(len = ExpandEnvironmentStringsW( source + 1, NULL, 0 ))) return FALSE;
+    if (!(expanded = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return FALSE;
+    if (ExpandEnvironmentStringsW( source + 1, expanded, len ) - 1 >= len) expanded[0] = 0;  /* failed or changed */
+    if (!(comma = wcsrchr( expanded, ',' )) || comma[1] != '-')
+    {
+        HeapFree( GetProcessHeap(), 0, expanded );
+        SetLastError( ERROR_INVALID_DATA );
+        return FALSE;
+    }
+    *comma = 0;
+    if (wcschr( expanded, '\\' )) lstrcpynW( path, expanded, MAX_PATH );
+    else
+    {
+        WCHAR system[MAX_PATH];
+        int written;
+
+        if (!directory && GetSystemDirectoryW( system, MAX_PATH )) directory = system;
+        written = directory ? swprintf( path, MAX_PATH, L"%s\\%s", directory, expanded ) : -1;
+        if (written < 0 || written >= MAX_PATH)
+        {
+            HeapFree( GetProcessHeap(), 0, expanded );
+            SetLastError( ERROR_INVALID_DATA );
+            return FALSE;
+        }
+    }
+    result = load_mui_string( path, wcstol( comma + 2, NULL, 10 ), buffer, size, &req, 0 );
+    HeapFree( GetProcessHeap(), 0, expanded );
+    if (needed) *needed = req;
+    if (result)
+    {
+        SetLastError( result );
+        return FALSE;
+    }
+    return TRUE;
+}
