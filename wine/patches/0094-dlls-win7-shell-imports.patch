+/***********************************************************************
+ *      CalculatePopupWindowPosition (USER32.@)
+ *
+ * Place a popup of SIZE at ANCHOR inside the work area of the anchor's
+ * monitor, flipping it to the other side of the anchor when it does not fit.
+ */
+BOOL WINAPI CalculatePopupWindowPosition( const POINT *anchor, const SIZE *size, UINT flags,
+                                          RECT *exclude, RECT *popup )
+{
+    MONITORINFO info = {sizeof(info)};
+    HMONITOR monitor;
+    LONG x, y;
+
+    if (!anchor || !size || !popup)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    monitor = MonitorFromPoint( *anchor, MONITOR_DEFAULTTONEAREST );
+    if (!GetMonitorInfoW( monitor, &info )) return FALSE;
+    if (flags & TPM_CENTERALIGN) x = anchor->x - size->cx / 2;
+    else if (flags & TPM_RIGHTALIGN) x = anchor->x - size->cx;
+    else x = anchor->x;
+    if (flags & TPM_VCENTERALIGN) y = anchor->y - size->cy / 2;
+    else if (flags & TPM_BOTTOMALIGN) y = anchor->y - size->cy;
+    else y = anchor->y;
+    if (x + size->cx > info.rcWork.right) x = (flags & TPM_RIGHTALIGN) ? info.rcWork.right - size->cx : anchor->x - size->cx;
+    if (y + size->cy > info.rcWork.bottom) y = anchor->y - size->cy;
+    if (x < info.rcWork.left) x = info.rcWork.left;
+    if (y < info.rcWork.top) y = info.rcWork.top;
+    SetRect( popup, x, y, x + size->cx, y + size->cy );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           PaintMonitor   (USER32.@)
+ *
+ * Windows 7's desktop calls it for each monitor when it has a wallpaper.
+ * There is no public description; traces show a monitor, a memory DC and a
+ * rectangle in the desktop's coordinates, such as (0,0)-(1024,728) on a
+ * 1024x768 monitor and (1280,0)-(2560,800) on a second monitor right of a
+ * 1280x800 one, so the monitor's own wallpaper (fitted to that monitor, as
+ * Windows does on each) is drawn there, within the rectangle. Exported on
+ * 64-bit only, where the caller passes the arguments in registers.
+ */
+BOOL WINAPI PaintMonitor( HMONITOR monitor, HDC hdc, const RECT *rect )
+{
+    MONITORINFO info = { sizeof(info) };
+    RECT area;
+    BOOL ret;
+    int saved;
+
+    TRACE( "%p %p %s\n", monitor, hdc, wine_dbgstr_rect( rect ) );
+
+    if (!GetMonitorInfoW( monitor, &info ) || !(saved = SaveDC( hdc ))) return FALSE;
+    if (rect) IntersectClipRect( hdc, rect->left, rect->top, rect->right, rect->bottom );
+    /* the desktop's coordinates start at the virtual screen's corner */
+    area = info.rcMonitor;
+    OffsetRect( &area, -GetSystemMetrics( SM_XVIRTUALSCREEN ), -GetSystemMetrics( SM_YVIRTUALSCREEN ) );
+    ret = paint_desktop_area( hdc, &area );
+    RestoreDC( hdc, saved );
+    return ret;
+}
