From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] user32, win32u: XP's caption animation when minimizing, maximizing and restoring

Purpose: windows minimize to the taskbar, maximize and restore with XP's
animation (Display Properties, Effects: "Animate windows when minimizing and
maximizing", on by default).
Windows behavior: minimizing draws the window's caption flying to its
taskbar button (DrawAnimatedRects, IDANI_CAPTION), and restoring or
maximizing draws it flying back before the window appears.
SPI_GETANIMATION/SPI_SETANIMATION read and write WindowMetrics\MinAnimate.
XP's xxxAnimateCaption draws the caption once with DrawCaptionTemp (the
classic active caption with its gradient, the icon and the title, never the
visual style's), one pixel shorter than SM_CYCAPTION, and for 250 ms
(CMS_ANIMATION) moves its top left corner and stretches its width between
the two rectangles, showing the left part of the strip; a rectangle taller
than a caption loses the window's borders (GetWindowBorders). xxxMinMaximize
passes the window's rectangles before and after, and for a minimize or a
restore from the taskbar the button's rectangle that the shell hook windows
give (xxxSendMinRectMessages); without one there is no animation.
Wine before: DrawAnimatedRects was a stub, SPI_GETANIMATION always answered
"disabled" and SPI_SETANIMATION was ignored.
Change: SPI_[GS]ETANIMATION use WindowMetrics\MinAnimate (default on, as
Windows). In the XP shell's session, DrawAnimatedRects(IDANI_CAPTION) moves
XP's caption strip as above, and DefWindowProc's SC_MINIMIZE, SC_MAXIMIZE and
SC_RESTORE call it with the window's rectangles and its taskbar button, asked
with WM_KLUDGEMINRECT from the shell hook windows under the taskbar (0182).
Evidence: XP source at Source/XPSP1/NT/windows/core/ntuser/kernel/minmax.c
(xxxAnimateCaption, xxxDrawAnimatedRects, xxxMinMaximize), rare.c
(xxxSendMinRectMessages) and rtl/winmgr.c (GetWindowBorders).
Scope: the XP shell's session (the Windows 7 and ReactOS sessions are not
animated); elsewhere DrawAnimatedRects does nothing, as before.
SPI_GETANIMATION answers from the registry everywhere.
---
 dlls/user32/nonclient.c |  98 ++++++++++++++++++++++++++++++++++++++++
 dlls/user32/uitools.c   | 116 +++++++++++++++++++++++++++++++++++++++++++++++-
 dlls/win32u/sysparams.c |  20 ++++++---
 3 files changed, 227 insertions(+), 7 deletions(-)

diff --git a/dlls/user32/nonclient.c b/dlls/user32/nonclient.c
index d65e7c9..c798132 100644
--- a/dlls/user32/nonclient.c
+++ b/dlls/user32/nonclient.c
@@ -21,6 +21,14 @@
 #include "user_private.h"
 #include "controls.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
+
+#ifndef IDANI_CAPTION
+#define IDANI_CAPTION 3
+#endif
+#ifndef WM_KLUDGEMINRECT
+#define WM_KLUDGEMINRECT 0x008b
+#endif
 
 
 #define SC_ABOUTWINE            (SC_SCREENSAVE+1)
@@ -63,10 +71,100 @@ BOOL WINAPI DrawCaptionTempA (HWND hwnd, HDC hdc, const RECT *rect, HFONT hFont,
  *
  * Handle a WM_SYSCOMMAND message. Called from DefWindowProc().
  */
+/* The rectangle of HWND's button on the taskbar, as XP's
+ * xxxSendMinRectMessages asks for it: WM_KLUDGEMINRECT to the windows
+ * registered with RegisterShellHookWindow (the Win4WineShellHook property,
+ * XP's task switcher, a child of the taskbar), which answer
+ * HSHELL_GETMINRECT. Empty when the window has no button. */
+struct min_rect_query
+{
+    HWND hwnd;
+    RECT rect;
+};
+
+static BOOL CALLBACK query_min_rect( HWND hook, LPARAM lparam )
+{
+    struct min_rect_query *query = (struct min_rect_query *)lparam;
+    DWORD_PTR result;
+
+    if (GetPropW( hook, L"Win4WineShellHook" ))
+        SendMessageTimeoutW( hook, WM_KLUDGEMINRECT, (WPARAM)query->hwnd, (LPARAM)&query->rect,
+                             SMTO_NORMAL, 100, &result );
+    return IsRectEmpty( &query->rect );
+}
+
+static BOOL get_min_rect( HWND hwnd, RECT *rect )
+{
+    struct min_rect_query query = {.hwnd = hwnd};
+    HWND tray = FindWindowW( L"Shell_TrayWnd", NULL );
+
+    if (tray) EnumChildWindows( tray, query_min_rect, (LPARAM)&query );
+    *rect = query.rect;
+    return !IsRectEmpty( rect );
+}
+
+/* Where XP's caption animation starts and ends for a minimize, maximize or
+ * restore of HWND, in the XP shell's session, as XP's xxxMinMaximize: the
+ * window's rectangles before and after, and its taskbar button when it is
+ * minimized or comes back from it (no animation for a window without one). */
+static BOOL min_max_animation( HWND hwnd, UINT command, RECT *from, RECT *to )
+{
+    WINDOWPLACEMENT placement = {.length = sizeof(placement)};
+    RECT window, task, work;
+    DWORD style = GetWindowLongW( hwnd, GWL_STYLE );
+
+    if (win4wine_shell() != WIN4WINE_SHELL_XP || (style & WS_CHILD) || (style & WS_CAPTION) != WS_CAPTION ||
+        !(style & WS_VISIBLE) || !GetWindowRect( hwnd, &window ) || !NtUserGetWindowPlacement( hwnd, &placement ))
+        return FALSE;
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    InflateRect( &work, GetSystemMetrics( SM_CXFRAME ), GetSystemMetrics( SM_CYFRAME ) );
+    OffsetRect( &placement.rcNormalPosition, work.left + GetSystemMetrics( SM_CXFRAME ),
+                work.top + GetSystemMetrics( SM_CYFRAME ) );
+
+    switch (command)
+    {
+    case SC_MINIMIZE:
+        if ((style & WS_MINIMIZE) || !get_min_rect( hwnd, &task )) return FALSE;
+        *from = window;
+        *to = task;
+        return TRUE;
+    case SC_MAXIMIZE:
+        if (style & WS_MAXIMIZE) return FALSE;
+        if (!(style & WS_MINIMIZE)) *from = window;
+        else if (!get_min_rect( hwnd, from )) return FALSE;
+        *to = work;
+        return TRUE;
+    case SC_RESTORE:
+        if (style & WS_MINIMIZE)
+        {
+            if (!get_min_rect( hwnd, from )) return FALSE;
+            *to = (placement.flags & WPF_RESTORETOMAXIMIZED) ? work : placement.rcNormalPosition;
+            return TRUE;
+        }
+        if (!(style & WS_MAXIMIZE)) return FALSE;
+        *from = window;
+        *to = placement.rcNormalPosition;
+        return TRUE;
+    }
+    return FALSE;
+}
+
 LRESULT NC_HandleSysCommand( HWND hwnd, WPARAM wParam, LPARAM lParam )
 {
+    UINT command = wParam & 0xfff0;
+    RECT from, to;
+    BOOL animate = min_max_animation( hwnd, command, &from, &to );
+
+    /* As on XP: the caption flies to the taskbar once the window is gone,
+     * and from where it was before the window appears again. */
+    if (animate && command != SC_MINIMIZE) DrawAnimatedRects( hwnd, IDANI_CAPTION, &from, &to );
     if (!NtUserMessageCall( hwnd, WM_SYSCOMMAND, wParam, lParam, 0, NtUserDefWindowProc, FALSE ))
+    {
+        if (animate && command == SC_MINIMIZE && IsIconic( hwnd ))
+            DrawAnimatedRects( hwnd, IDANI_CAPTION, &from, &to );
         return 0;
+    }
+    if (animate && command == SC_MINIMIZE && IsIconic( hwnd )) DrawAnimatedRects( hwnd, IDANI_CAPTION, &from, &to );
 
     switch (wParam & 0xfff0)
     {
diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
index d4b51a9..6579662 100644
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -31,6 +31,10 @@
 #include "wine/debug.h"
 #include "wine/win4wine.h"
 
+#ifndef IDANI_CAPTION
+#define IDANI_CAPTION 3
+#endif
+
 WINE_DEFAULT_DEBUG_CHANNEL(graphics);
 
 /* These tables are used in:
@@ -1518,9 +1522,119 @@ BOOL WINAPI DrawFocusRect( HDC hdc, const RECT* rc )
 /**********************************************************************
  *		DrawAnimatedRects (USER32.@)
  */
+static LRESULT CALLBACK animation_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_NCHITTEST) return HTTRANSPARENT;
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+/* The borders XP's GetWindowBorders counts around a window, which its
+ * caption animation leaves out of a window's rectangle. */
+static int window_borders( HWND hwnd )
+{
+    DWORD style = GetWindowLongW( hwnd, GWL_STYLE ), ex_style = GetWindowLongW( hwnd, GWL_EXSTYLE );
+    int borders = 0, border = 1;
+
+    if (ex_style & WS_EX_WINDOWEDGE) borders += 2;
+    else if (ex_style & WS_EX_STATICEDGE) borders++;
+    if ((style & WS_CAPTION) || (ex_style & WS_EX_DLGMODALFRAME)) borders++;
+    if ((style & WS_THICKFRAME) && SystemParametersInfoW( SPI_GETBORDER, 0, &border, 0 )) borders += border;
+    return borders;
+}
+
 BOOL WINAPI DrawAnimatedRects( HWND hwnd, INT idAni, const RECT* lprcFrom, const RECT* lprcTo )
 {
-    FIXME("(%p,%d,%p,%p): stub\n",hwnd,idAni,lprcFrom,lprcTo);
+    static const WCHAR class_name[] = L"Win4WineCaptionAnimation";
+    /* XP's CMS_ANIMATION */
+    static const DWORD duration = 250;
+    /* The caption colour behind the first frame, rather than black. */
+    WNDCLASSW wc = {.lpfnWndProc = animation_proc, .lpszClassName = class_name,
+                    .hbrBackground = (HBRUSH)(COLOR_ACTIVECAPTION + 1)};
+    ANIMATIONINFO info = {.cbSize = sizeof(info)};
+    RECT from = *lprcFrom, to = *lprcTo, strip;
+    BOOL gradient = FALSE;
+    HBITMAP bitmap, old_bitmap;
+    DWORD start, elapsed;
+    int cy, borders;
+    HDC screen, dc, mem;
+    HWND popup;
+
+    TRACE("(%p,%d,%p,%p)\n",hwnd,idAni,lprcFrom,lprcTo);
+    /* The caption animation of XP's minimize, maximize and restore, for the
+     * XP shell's session; Wine has none otherwise. */
+    if (win4wine_shell() != WIN4WINE_SHELL_XP || idAni != IDANI_CAPTION || !lprcFrom || !lprcTo) return TRUE;
+    if (!SystemParametersInfoW( SPI_GETANIMATION, sizeof(info), &info, 0 ) || !info.iMinAnimate) return TRUE;
+
+    /* As XP's xxxAnimateCaption: a caption strip one pixel shorter than the
+     * caption moves between the top left corners and stretches between the
+     * widths, inside the borders of a rectangle taller than a caption. */
+    cy = GetSystemMetrics( SM_CYCAPTION ) - 1;
+    borders = window_borders( hwnd );
+    if (from.bottom - from.top > cy + 1)
+    {
+        from.left += borders;
+        from.top += borders;
+        from.right -= borders;
+    }
+    if (to.bottom - to.top > cy + 1)
+    {
+        to.left += borders;
+        to.top += borders;
+        to.right -= borders;
+    }
+    SetRect( &strip, 0, 0, max( from.right - from.left, to.right - to.left ), cy );
+    if (strip.right <= 0 || cy <= 0) return TRUE;
+
+    /* XP draws it once, as DrawCaptionTemp's active caption (never the
+     * visual style's), and shows its left part at each width. */
+    SystemParametersInfoW( SPI_GETGRADIENTCAPTIONS, 0, &gradient, 0 );
+    screen = NtUserGetDC( 0 );
+    mem = CreateCompatibleDC( screen );
+    bitmap = CreateCompatibleBitmap( screen, strip.right, cy );
+    NtUserReleaseDC( 0, screen );
+    if (!mem || !bitmap)
+    {
+        if (bitmap) DeleteObject( bitmap );
+        if (mem) DeleteDC( mem );
+        return TRUE;
+    }
+    old_bitmap = SelectObject( mem, bitmap );
+    NtUserDrawCaptionTemp( hwnd, mem, &strip, 0, 0, NULL, DC_ACTIVE | DC_ICON | DC_TEXT | (gradient ? DC_GRADIENT : 0) );
+
+    /* In the program's module: user32's own is reserved for system classes. */
+    wc.hInstance = GetModuleHandleW( NULL );
+    RegisterClassW( &wc );
+    if ((popup = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+                                  class_name, L"", WS_POPUP, from.left, from.top, 1, 1,
+                                  NULL, NULL, wc.hInstance, NULL )))
+    {
+        start = GetTickCount();
+        elapsed = 0;
+        while (elapsed <= duration)
+        {
+            int left = from.left + MulDiv( to.left - from.left, elapsed, duration );
+            int top = from.top + MulDiv( to.top - from.top, elapsed, duration );
+            int cx = (from.right - from.left) + MulDiv( (to.right - to.left) - (from.right - from.left), elapsed, duration );
+
+            if (cx > 0)
+            {
+                NtUserSetWindowPos( popup, HWND_TOPMOST, left, top, cx, cy, SWP_NOACTIVATE | SWP_SHOWWINDOW );
+                if ((dc = NtUserGetDCEx( popup, 0, DCX_WINDOW | DCX_CACHE )))
+                {
+                    BitBlt( dc, 0, 0, cx, cy, mem, 0, 0, SRCCOPY );
+                    NtUserReleaseDC( popup, dc );
+                }
+                GdiFlush();
+            }
+            /* Not Sleep: waiting lets the window surface reach the screen. */
+            MsgWaitForMultipleObjects( 0, NULL, FALSE, 10, 0 );
+            elapsed = GetTickCount() - start;
+        }
+        NtUserDestroyWindow( popup );
+    }
+    SelectObject( mem, old_bitmap );
+    DeleteObject( bitmap );
+    DeleteDC( mem );
     return TRUE;
 }
 
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 3e621b7..18cc1a9 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -5596,6 +5596,7 @@ static BOOL_ENTRY( SCREENSAVEACTIVE, TRUE, DESKTOP_KEY, "ScreenSaveActive" );
 static BOOL_ENTRY( SCREENSAVERRUNNING, FALSE, DESKTOP_KEY, "WINE_ScreenSaverRunning" ); /* FIXME - real value */
 static BOOL_ENTRY( SHOWSOUNDS, FALSE, SHOWSOUNDS_KEY, "On" );
 static BOOL_ENTRY( SNAPTODEFBUTTON, FALSE, MOUSE_KEY, "SnapToDefaultButton" );
+static BOOL_ENTRY( MINANIMATE, TRUE, METRICS_KEY, "MinAnimate" );
 static BOOL_ENTRY_MIRROR( ICONTITLEWRAP, TRUE, DESKTOP_KEY, "IconTitleWrap", METRICS_KEY );
 static BOOL_ENTRY( AUDIODESC_ON, FALSE, AUDIODESC_KEY, "On" );
 
@@ -5767,6 +5768,7 @@ static union sysparam_all_entry * const default_entries[] =
     (union sysparam_all_entry *)&entry_SMCAPTIONHEIGHT,
     (union sysparam_all_entry *)&entry_SMCAPTIONWIDTH,
     (union sysparam_all_entry *)&entry_SNAPTODEFBUTTON,
+    (union sysparam_all_entry *)&entry_MINANIMATE,
     (union sysparam_all_entry *)&entry_USERPREFERENCESMASK,
     (union sysparam_all_entry *)&entry_WHEELSCROLLCHARS,
     (union sysparam_all_entry *)&entry_WHEELSCROLLLINES,
@@ -6514,18 +6516,24 @@ BOOL WINAPI NtUserSystemParametersInfo( UINT action, UINT val, void *ptr, UINT w
     case SPI_GETANIMATION:
     {
         ANIMATIONINFO *anim_info = ptr;
+        BOOL enabled;
 
-	/* Tell it "disabled" */
-	if (anim_info && anim_info->cbSize == sizeof(ANIMATIONINFO))
+        /* "Animate windows when minimizing and maximizing" (nonzero == enabled) */
+        if (anim_info && anim_info->cbSize == sizeof(ANIMATIONINFO) && get_entry( &entry_MINANIMATE, 0, &enabled ))
         {
-            /* Minimize and restore animation is disabled (nonzero == enabled) */
-	    anim_info->iMinAnimate = 0;
+            anim_info->iMinAnimate = enabled;
             ret = TRUE;
         }
-	break;
+        break;
     }
 
-    WINE_SPI_WARN(SPI_SETANIMATION);
+    case SPI_SETANIMATION:
+    {
+        ANIMATIONINFO *anim_info = ptr;
+        if (anim_info && anim_info->cbSize == sizeof(ANIMATIONINFO))
+            ret = set_entry( &entry_MINANIMATE, anim_info->iMinAnimate != 0, NULL, winini );
+        break;
+    }
 
     case SPI_GETFONTSMOOTHING:
         ret = get_entry( &entry_FONTSMOOTHING, val, ptr );
