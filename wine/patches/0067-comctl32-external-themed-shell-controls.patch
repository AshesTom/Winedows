diff --git a/dlls/comctl32/commctrl.c b/dlls/comctl32/commctrl.c
index 80404b8..1867d02 100644
--- a/dlls/comctl32/commctrl.c
+++ b/dlls/comctl32/commctrl.c
@@ -69,6 +69,7 @@
 #include "winreg.h"
 #include "comctl32.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(commctrl);
 
@@ -166,6 +167,60 @@ static void unregister_classes(void)
     }
 }
 
+#if __WINE_COMCTL32_VERSION == 6
+/* For the opted-in external XP shell, whose native comctl32 runs without its
+ * SxS activation context: register Wine's themed version of a user control as
+ * "Win4Wine" + name in this separately named module; user32 then creates the
+ * process's controls from it under their usual class names. */
+BOOL WINAPI Win4WineRegisterControl(const WCHAR *class)
+{
+    static const struct
+    {
+        const WCHAR nameW[16];
+        void (*fn_register)(const WCHAR *);
+    }
+    classes[] =
+    {
+        { L"Button",    BUTTON_Register_Name },
+        { L"ComboBox",  COMBO_Register_Name },
+        { L"ComboLBox", COMBOLBOX_RegisterAlias },
+        { L"Edit",      EDIT_Register_Name },
+        { L"ListBox",   LISTBOX_Register_Name },
+        { L"Static",    STATIC_Register_Name },
+    };
+    WCHAR alias[32];
+    WNDCLASSW wc;
+
+    if (!class || !COMCTL32_IsExternalAlias()) return FALSE;
+    for (unsigned int i = 0; i < ARRAY_SIZE(classes); i++)
+    {
+        if (wcsicmp(class, classes[i].nameW)) continue;
+        lstrcpyW(alias, L"Win4Wine");
+        lstrcatW(alias, classes[i].nameW);
+        if (!GetClassInfoW(COMCTL32_hModule, alias, &wc)) classes[i].fn_register(alias);
+        return GetClassInfoW(COMCTL32_hModule, alias, &wc);
+    }
+    return FALSE;
+}
+
+/* Whether this is the external shell's separately named copy of comctl32. */
+BOOL COMCTL32_IsExternalAlias(void)
+{
+    static int alias = -1;
+    if (alias < 0)
+    {
+        WCHAR path[MAX_PATH];
+        const WCHAR *name;
+        DWORD length = GetModuleFileNameW(COMCTL32_hModule, path, ARRAY_SIZE(path));
+        name = wcsrchr(path, '\\');
+        name = name ? name + 1 : path;
+        alias = length && !wcsicmp(name, L"win4wine-controls.dll")
+                && win4wine_external_shell();
+    }
+    return alias;
+}
+#endif /* __WINE_COMCTL32_VERSION == 6 */
+
 BOOL WINAPI RegisterClassNameW(const WCHAR *class)
 {
     int min = 0, max = ARRAY_SIZE(classes) - 1;
