+    if (!IS_INTRESOURCE(className) && win4wine_shell() && win4wine_shell() != WIN4WINE_SHELL_REACTOS)
     {
+        const WCHAR *themed = NULL;
         WCHAR parent_class[64];
-        if (GetClassNameW(cs->hwndParent, parent_class, ARRAY_SIZE(parent_class))
+        if (!wcsicmp(className, L"Button") && cs->hwndParent
+            && GetClassNameW(cs->hwndParent, parent_class, ARRAY_SIZE(parent_class))
             && !wcsicmp(parent_class, L"Shell_TrayWnd"))
         {
             HMODULE controls = LoadLibraryW(L"win4wine-controls.dll");
             BOOL (WINAPI *register_button)(void) = controls
                 ? (void *)GetProcAddress(controls, "Win4WineRegisterStartButton") : NULL;
             if (register_button && register_button())
-                className = L"Win4WineStartButton";
+                themed = L"Win4WineStartButton";
         }
+        else themed = external_shell_control_class( className );
+        if (themed) className = themed;
     }
 
     init_class_name( &class, className );
