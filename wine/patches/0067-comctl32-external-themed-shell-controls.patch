 }
 
 
+/* For the opted-in external XP shell running the native comctl32 without its
+ * SxS activation context: the XP shell's controls are themed v6 controls.
+ * Register Wine's from the separately named controls module as
+ * "win4wine!" + name, versioned so that GetClassName still returns name, and
+ * return that class name; NULL when it is not available. */
+const WCHAR *external_shell_control_class( const WCHAR *name )
+{
+    static const WCHAR prefix[] = L"win4wine!";
+    static const WCHAR *names[] = { L"Button", L"ComboBox", L"ComboLBox", L"Edit", L"ListBox", L"Static" };
+    static const WCHAR *classes[] = { L"win4wine!Button", L"win4wine!ComboBox", L"win4wine!ComboLBox",
+                                      L"win4wine!Edit", L"win4wine!ListBox", L"win4wine!Static" };
+    static LONG registered[ARRAY_SIZE(names)];
+    static const char signature[] = "Wine builtin DLL";
+    HMODULE comctl32, controls;
+    BOOL (WINAPI *register_control)(const WCHAR *);
+    WCHAR plain[32];
+    WNDCLASSEXW wc = {sizeof(wc)};
+    struct client_menu_name menu_name;
+    UNICODE_STRING class_name, version;
+    unsigned int i;
+
+    if (IS_INTRESOURCE( name ) || !win4wine_external_shell()) return NULL;
+    for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcsicmp( name, names[i] )) break;
+    if (i == ARRAY_SIZE(names)) return NULL;
+    if (ReadAcquire( &registered[i] )) return classes[i];
+    /* Only where comctl32 is the native one; Wine's own finds its classes itself. */
+    if (!(comctl32 = GetModuleHandleW( L"comctl32.dll" )) ||
+        !memcmp( (IMAGE_DOS_HEADER *)comctl32 + 1, signature, sizeof(signature) ))
+        return NULL;
+    if (!(controls = LoadLibraryW( L"win4wine-controls.dll" ))) return NULL;
+    register_control = (void *)GetProcAddress( controls, "Win4WineRegisterControl" );
+    lstrcpyW( plain, L"Win4Wine" );
+    lstrcatW( plain, names[i] );
+    if (!register_control || !register_control( names[i] ) || !GetClassInfoExW( controls, plain, &wc ))
+        return NULL;
+    wc.lpszClassName = classes[i];
+    wc.lpszMenuName = NULL;
+    RtlInitUnicodeString( &class_name, classes[i] );
+    version.Buffer = (WCHAR *)classes[i];
+    version.Length = version.MaximumLength = (ARRAY_SIZE(prefix) - 1) * sizeof(WCHAR);
+    if (!alloc_menu_nameW( &menu_name, NULL )) return NULL;
+    if (!NtUserRegisterClassExWOW( &wc, &class_name, &version, &menu_name, 0, 0, NULL ))
+    {
+        free_menu_name( &menu_name );
+        if (GetLastError() != ERROR_CLASS_ALREADY_EXISTS) return NULL;
+    }
+    WriteRelease( &registered[i], TRUE );
+    return classes[i];
+}
+
 /***********************************************************************
  *		RegisterClassExW (USER32.@)
  */
