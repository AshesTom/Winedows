diff --git a/dlls/user32/class.c b/dlls/user32/class.c
index a754720..863d49f 100644
--- a/dlls/user32/class.c
+++ b/dlls/user32/class.c
@@ -24,6 +24,7 @@
 #include "user_private.h"
 #include "controls.h"
 #include "wine/debug.h"
