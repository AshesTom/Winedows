+/* GetObject gives a DIB section's height as positive whichever way its rows
+ * go (as on Windows), so the device's top-left pixel tells: it is the first
+ * pixel of the bits of a top-down DIB, of their last row for a bottom-up one. */
+static BOOL dib_is_top_down(HDC hdc, const DIBSECTION *dib)
+{
+    DWORD *first = dib->dsBm.bmBits;
+    DWORD *last = (DWORD *)((BYTE *)dib->dsBm.bmBits + (dib->dsBm.bmHeight - 1) * dib->dsBm.bmWidthBytes);
+    DWORD saved_first = *first, saved_last = *last;
+    POINT origin = {0, 0};
+    COLORREF probe;
+    BOOL top_down;
+
+    if (dib->dsBm.bmHeight == 1) return TRUE;
+    DPtoLP(hdc, &origin, 1);
+    GdiFlush();
+    *first = 0x00010203;
+    *last = 0x00040506;
+    probe = GetPixel(hdc, origin.x, origin.y);
+    top_down = probe == RGB(0x01, 0x02, 0x03) || (probe != RGB(0x04, 0x05, 0x06) && dib->dsBmih.biHeight < 0);
+    *first = saved_first;
+    *last = saved_last;
+    return top_down;
+}
+
 static DWORD *dib_row(const DIBSECTION *dib, int y)
 {
+    /* dsBmih.biHeight is made negative for a top-down DIB (dib_is_top_down) */
     int row = dib->dsBmih.biHeight > 0 ? dib->dsBm.bmHeight - 1 - y : y;
     return (DWORD *)((BYTE *)dib->dsBm.bmBits + row * dib->dsBm.bmWidthBytes);
 }
 
+static void draw_changed_pixels_text(HDC hdc, const DIBSECTION *dib, const RECT *area, const WCHAR *text,
+                                     int count, DWORD flags, RECT *rect, const DTTOPTS *options)
+{
+    int x, y, width = area->right - area->left, height = area->bottom - area->top;
+    DWORD *before;
+
+    if (!(before = malloc(width * height * sizeof(DWORD))))
+    {
+        draw_text_or_callback(hdc, text, count, flags, rect, options);
+        return;
+    }
+    GdiFlush();
+    for (y = 0; y < height; y++)
+        memcpy(before + y * width, dib_row(dib, area->top + y) + area->left, width * sizeof(DWORD));
+    draw_text_or_callback(hdc, text, count, flags, rect, options);
+    GdiFlush();
+    for (y = 0; y < height; y++)
+    {
+        DWORD *row = dib_row(dib, area->top + y) + area->left;
+        for (x = 0; x < width; x++)
+            if ((row[x] & 0xffffff) != (before[y * width + x] & 0xffffff)) row[x] |= 0xff000000;
+    }
+    free(before);
+}
+
+/* Blend COLOR with coverage COVER (0-255) into a premultiplied pixel. */
+static DWORD blend_premultiplied(DWORD dst, COLORREF color, UINT cover)
+{
+    UINT inv = 255 - cover;
+    UINT a = cover + ((dst >> 24) * inv + 127) / 255;
+    UINT r = (GetRValue(color) * cover + ((dst >> 16) & 0xff) * inv + 127) / 255;
+    UINT g = (GetGValue(color) * cover + ((dst >> 8) & 0xff) * inv + 127) / 255;
+    UINT b = (GetBValue(color) * cover + (dst & 0xff) * inv + 127) / 255;
+    return (a << 24) | (r << 16) | (g << 8) | b;
+}
+
