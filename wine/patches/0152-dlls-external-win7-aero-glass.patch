+    halo = cover + width * height;
+    SelectObject(mask_dc, mask_bitmap);
+    SelectObject(mask_dc, mask_font);
+    SetTextColor(mask_dc, RGB(255, 255, 255));
+    SetBkMode(mask_dc, TRANSPARENT);
+    SetTextAlign(mask_dc, GetTextAlign(hdc));
+    SetTextCharacterExtra(mask_dc, GetTextCharacterExtra(hdc));
+    OffsetRect(&text_rect, -area.left, -area.top);
+    DrawTextW(mask_dc, text, count, &text_rect, flags & ~DT_CALCRECT);
     GdiFlush();
     for (y = 0; y < height; y++)
-        memcpy(before + y * width, dib_row(&dib, area.top + y) + area.left, width * sizeof(DWORD));
-    draw_text_or_callback(hdc, text, count, flags, rect, options);
+        for (x = 0; x < width; x++)
+        {
+            DWORD pixel = mask_bits[y * width + x];
+            cover[y * width + x] = max(max(pixel & 0xff, (pixel >> 8) & 0xff), (pixel >> 16) & 0xff);
+        }
+
     GdiFlush();
+    if (glow > 0)
+    {
+        /* The glow: the coverage spread by a box of GLOW pixels each way. */
+        int radius = glow, i, j;
+        for (y = 0; y < height; y++)
