+/* win4wine: premultiplied TOP over BOTTOM */
+static inline DWORD premultiplied_over( DWORD top, DWORD bottom )
+{
+    UINT inv = 255 - (top >> 24);
+
+    return (min( 255, (top >> 24) + (bottom >> 24) * inv / 255 ) << 24) |
+           (min( 255, ((top >> 16) & 0xff) + ((bottom >> 16) & 0xff) * inv / 255 ) << 16) |
+           (min( 255, ((top >> 8) & 0xff) + ((bottom >> 8) & 0xff) * inv / 255 ) << 8) |
+           min( 255, (top & 0xff) + (bottom & 0xff) * inv / 255 );
+}
