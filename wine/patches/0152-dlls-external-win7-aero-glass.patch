+            DWORD *row = dib_row(&dib, area.top + y) + area.left;
+            for (x = 0; x < width; x++)
+                if (halo[y * width + x]) row[x] = blend_premultiplied(row[x], glow_color, halo[y * width + x]);
+        }
+    }
     for (y = 0; y < height; y++)
     {
         DWORD *row = dib_row(&dib, area.top + y) + area.left;
         for (x = 0; x < width; x++)
-            if ((row[x] & 0xffffff) != (before[y * width + x] & 0xffffff)) row[x] |= 0xff000000;
+            if (cover[y * width + x]) row[x] = blend_premultiplied(row[x], color, cover[y * width + x]);
     }
-    free(before);
+    free(cover);
+    DeleteDC(mask_dc);
+    DeleteObject(mask_bitmap);
+    DeleteObject(mask_font);
 }
 
