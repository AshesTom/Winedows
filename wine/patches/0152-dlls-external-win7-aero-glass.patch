 /**********************************************************************
  *           DwmGetColorizationColor      (DWMAPI.@)
  */
+/* win4wine: the glass's colorization color, as Windows keeps it
+ * (HKCU\Software\Microsoft\Windows\DWM ColorizationColor), else Windows 7's
+ * default (the Aero theme's "Sky"). */
+static DWORD colorization_color(void)
+{
+    DWORD color = 0x6b74b8fc, value, size = sizeof(value);
+
+    if (!RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"ColorizationColor",
+                      RRF_RT_REG_DWORD, NULL, &value, &size))
+        color = value;
+    return color;
+}
+
+HRESULT WINAPI WICCreateImagingFactory_Proxy(UINT, IWICImagingFactory **);
+
+static BOOL CALLBACK first_stream(HMODULE module, const WCHAR *type, WCHAR *name, LONG_PTR param)
+{
+    HRSRC *found = (HRSRC *)param;
+
+    *found = FindResourceW(module, name, type);
+    return !*found;
+}
+
+/* win4wine: the glass's reflection, as Windows 7's DWM draws it over the
+ * colorization color: part 40 of the theme's DWMWindow atlas (the theme
+ * file's PNG stream), premultiplied, as a top-down DIB section, or 0. */
+static HBITMAP glass_reflection(void)
+{
+    static HBITMAP reflection;
+    static BOOL tried;
+    BITMAPINFO info = {{ sizeof(info.bmiHeader) }};
+    IWICImagingFactory *factory = NULL;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICBitmapSource *converted = NULL;
+    IWICStream *stream = NULL;
+    WCHAR path[MAX_PATH];
+    HMODULE theme_file = NULL;
+    HRSRC resource = NULL;
+    HTHEME theme;
+    RECT rect = {0};
+    WICRect wic_rect;
+    void *bits;
+
+    if (tried) return reflection;
+    tried = TRUE;
+    if (!(theme = OpenThemeData(NULL, L"DWMWindow"))) return 0;
+    if (FAILED(GetThemeRect(theme, 40, 0, TMT_ATLASRECT, &rect)) || IsRectEmpty(&rect) ||
+        FAILED(GetCurrentThemeName(path, ARRAY_SIZE(path), NULL, 0, NULL, 0)) ||
+        !(theme_file = LoadLibraryExW(path, NULL, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE)))
+        goto done;
+    EnumResourceNamesW(theme_file, L"STREAM", first_stream, (LONG_PTR)&resource);
+    if (!resource || FAILED(WICCreateImagingFactory_Proxy(WINCODEC_SDK_VERSION, &factory)) ||
+        FAILED(IWICImagingFactory_CreateStream(factory, &stream)) ||
+        FAILED(IWICStream_InitializeFromMemory(stream, LockResource(LoadResource(theme_file, resource)),
+                                               SizeofResource(theme_file, resource))) ||
+        FAILED(IWICImagingFactory_CreateDecoderFromStream(factory, (IStream *)stream, NULL,
+                                                          WICDecodeMetadataCacheOnDemand, &decoder)) ||
+        FAILED(IWICBitmapDecoder_GetFrame(decoder, 0, &frame)) ||
+        FAILED(WICConvertBitmapSource(&GUID_WICPixelFormat32bppPBGRA, (IWICBitmapSource *)frame, &converted)))
+        goto done;
+    info.bmiHeader.biWidth = rect.right - rect.left;
+    info.bmiHeader.biHeight = -(rect.bottom - rect.top);
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    if (!(reflection = CreateDIBSection(NULL, &info, DIB_RGB_COLORS, &bits, NULL, 0))) goto done;
+    wic_rect.X = rect.left;
+    wic_rect.Y = rect.top;
+    wic_rect.Width = rect.right - rect.left;
+    wic_rect.Height = rect.bottom - rect.top;
+    if (FAILED(IWICBitmapSource_CopyPixels(converted, &wic_rect, wic_rect.Width * 4, wic_rect.Width * 4 * wic_rect.Height, bits)))
+    {
+        DeleteObject(reflection);
+        reflection = 0;
+    }
+done:
+    if (converted) IWICBitmapSource_Release(converted);
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (decoder) IWICBitmapDecoder_Release(decoder);
+    if (stream) IWICStream_Release(stream);
+    if (factory) IWICImagingFactory_Release(factory);
+    if (theme_file) FreeLibrary(theme_file);
+    CloseThemeData(theme);
+    TRACE("reflection %p %s\n", reflection, wine_dbgstr_rect(&rect));
+    return reflection;
+}
+
 HRESULT WINAPI DwmGetColorizationColor(DWORD *colorization, BOOL *opaque_blend)
 {
-    FIXME("(%p, %p) stub\n", colorization, opaque_blend);
+    BOOL enabled = FALSE;
 
-    return E_NOTIMPL;
+    TRACE("(%p, %p)\n", colorization, opaque_blend);
+
+    if (!colorization || !opaque_blend)
+        return E_INVALIDARG;
+    if (DwmIsCompositionEnabled(&enabled) != S_OK || !enabled)
+    {
+        FIXME("(%p, %p): no desktop composition\n", colorization, opaque_blend);
+        return E_NOTIMPL;
+    }
+    *colorization = colorization_color();
+    *opaque_blend = FALSE;
+    return S_OK;
 }
 
 /**********************************************************************
@@ -183,9 +289,42 @@
  */
 HRESULT WINAPI DwmEnableBlurBehindWindow(HWND hWnd, const DWM_BLURBEHIND *pBlurBuf)
 {
-    FIXME("%p %p\n", hWnd, pBlurBuf);
+    BOOL enabled = FALSE, glass;
 
-    return E_NOTIMPL;
+    TRACE("%p %p\n", hWnd, pBlurBuf);
+
+    if (!pBlurBuf)
+        return E_INVALIDARG;
+    /* win4wine: with Aero (DwmIsCompositionEnabled), the window keeps the
+     * alpha of its pixels and the X compositor blurs what is behind it
+     * (winex11's glass windows). The blur region is not kept: the whole
+     * window is glass where its pixels are translucent. */
+    if (DwmIsCompositionEnabled(&enabled) != S_OK || !enabled)
+    {
+        FIXME("%p %p: no desktop composition\n", hWnd, pBlurBuf);
+        return E_NOTIMPL;
+    }
+    if (!IsWindow(hWnd))
+        return E_HANDLE;
+    if (!(pBlurBuf->dwFlags & DWM_BB_ENABLE))
+        return S_OK;
+    glass = pBlurBuf->fEnable != 0;
+    if (!GetPropW(hWnd, L"__win4wine_glass") == !glass)
+        return S_OK;
+    /* winex11 puts the colorization color under the window's pixels */
+    if (glass)
+    {
+        HBITMAP reflection = glass_reflection();
+
+        if (reflection) SetPropW(hWnd, L"__win4wine_glass_reflection", reflection);
+        SetPropW(hWnd, L"__win4wine_glass", (HANDLE)(ULONG_PTR)(colorization_color() | !colorization_color()));
+    }
+    else RemovePropW(hWnd, L"__win4wine_glass");
+    /* A new window surface, with or without alpha */
+    SetWindowPos(hWnd, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+                 SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+    RedrawWindow(hWnd, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN);
+    return S_OK;
 }
 
