+/***********************************************************************
+ *           SetLayoutWidth    (GDI32.@)
+ *
+ * SetLayout with the width that mirroring flips around (-1: the device's).
+ */
+DWORD WINAPI SetLayoutWidth( HDC hdc, LONG width, DWORD layout )
+{
+    TRACE( "hdc %p width %ld layout %08lx\n", hdc, width, layout );
+    if (is_meta_dc( hdc )) return GDI_ERROR;
+    return NtGdiSetLayout( hdc, width, layout );
+}
+
