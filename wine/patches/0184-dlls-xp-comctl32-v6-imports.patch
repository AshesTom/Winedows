+/******************************************************************************
+ *	RtlRunEncodeUnicodeString	(NTDLL.@)
+ *
+ * Make a string unreadable in memory (XP's edit controls keep passwords so):
+ * each byte is XORed with SEED and the byte encoded before it. A zero SEED
+ * is replaced by one taken from the time. RtlRunDecodeUnicodeString with the
+ * same seed restores the string.
+ */
+void WINAPI RtlRunEncodeUnicodeString( UCHAR *seed, UNICODE_STRING *str )
+{
+    UCHAR *bytes = (UCHAR *)str->Buffer;
+    unsigned int i;
+
+    if (!*seed)
+    {
+        LARGE_INTEGER now;
+        NtQuerySystemTime( &now );
+        *seed = (UCHAR)(now.QuadPart >> 8) | (UCHAR)now.QuadPart;
+        if (!*seed) *seed = 1;
+    }
+    if (!str->Length) return;
+    bytes[0] ^= *seed | 0x43;
+    for (i = 1; i < str->Length; i++) bytes[i] ^= bytes[i - 1] ^ *seed;
+}
+
+
+/******************************************************************************
+ *	RtlRunDecodeUnicodeString	(NTDLL.@)
+ */
+void WINAPI RtlRunDecodeUnicodeString( UCHAR seed, UNICODE_STRING *str )
+{
+    UCHAR *bytes = (UCHAR *)str->Buffer;
+    unsigned int i;
+
+    if (!str->Length) return;
+    for (i = str->Length - 1; i > 0; i--) bytes[i] ^= bytes[i - 1] ^ seed;
+    bytes[0] ^= seed | 0x43;
+}
