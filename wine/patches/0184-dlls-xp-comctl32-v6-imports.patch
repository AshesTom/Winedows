@@ -153,3 +159,71 @@ BOOL WINAPI OemToCharW( LPCSTR s, LPWSTR d )
     if (!s || !d) return FALSE;
     return OemToCharBuffW( s, d, strlen( s ) + 1 );
 }
+
+
+/* Code page conversions of the private exports below: a string of -1
+ * characters is NUL-terminated (counted with its NUL; -2 for the ANSI
+ * string of MBToWCSEx counts it without), a destination of -1 characters
+ * is allocated from the process heap to fit, and the result is the number
+ * of characters converted, as many as fit (0 on failure, which frees what
+ * was allocated). */
+static BOOL is_ansi_code_page( WORD code_page )
+{
+    return code_page == CP_ACP || code_page == GetACP();
+}
+
+/***********************************************************************
+ *           MBToWCSEx   (USER32.@)
+ */
+int WINAPI MBToWCSEx( WORD code_page, const char *src, int src_len, WCHAR **dst, int dst_len, BOOL alloc )
+{
+    ULONG bytes;
+    int ret;
+
+    TRACE( "%u %s %d %p %d %d\n", code_page, debugstr_an( src, src_len ), src_len, dst, dst_len, alloc );
+    if (!src_len || !dst_len || !src || src_len < -2 || dst_len < -1) return 0;
+    if (src_len < 0 && !(src_len = strlen( src ) + 2 + src_len)) return 0;
+    if (dst_len == -1)
+    {
+        if (!alloc) return 0;
+        dst_len = src_len;
+    }
+    if (alloc && !(*dst = HeapAlloc( GetProcessHeap(), 0, dst_len * sizeof(WCHAR) ))) return 0;
+
+    if (is_ansi_code_page( code_page ))
+        ret = RtlMultiByteToUnicodeN( *dst, dst_len * sizeof(WCHAR), &bytes, src, src_len ) ? 0 : bytes / sizeof(WCHAR);
+    else
+        ret = MultiByteToWideChar( code_page, 0, src, src_len, *dst, dst_len );
+    if (!ret && alloc) HeapFree( GetProcessHeap(), 0, *dst );
+    return ret;
+}
+
+/***********************************************************************
+ *           WCSToMBEx   (USER32.@)
+ */
+int WINAPI WCSToMBEx( WORD code_page, const WCHAR *src, int src_len, char **dst, int dst_len, BOOL alloc )
+{
+    NTSTATUS status;
+    ULONG bytes;
+    int ret;
+
+    TRACE( "%u %s %d %p %d %d\n", code_page, debugstr_wn( src, src_len ), src_len, dst, dst_len, alloc );
+    if (!src_len || !dst_len || !src || src_len < -1 || dst_len < -1) return 0;
+    if (src_len == -1) src_len = lstrlenW( src ) + 1;
+    if (dst_len == -1)
+    {
+        if (!alloc) return 0;
+        dst_len = src_len * 2;  /* a double-byte character set's worst case */
+    }
+    if (alloc && !(*dst = HeapAlloc( GetProcessHeap(), 0, dst_len ))) return 0;
+
+    if (is_ansi_code_page( code_page ))
+    {
+        /* a destination too small keeps what fits */
+        status = RtlUnicodeToMultiByteN( *dst, dst_len, &bytes, src, src_len * sizeof(WCHAR) );
+        ret = (!status || status == STATUS_BUFFER_OVERFLOW) ? bytes : 0;
+    }
+    else ret = WideCharToMultiByte( code_page, 0, src, src_len, *dst, dst_len, NULL, NULL );
+    if (!ret && alloc) HeapFree( GetProcessHeap(), 0, *dst );
+    return ret;
+}
diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
index 6efe783..826b146 100644
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -1235,6 +1235,32 @@ static BOOL UITOOLS95_DrawFrameMenu(HDC dc, LPRECT r, UINT uFlags)
 }
 
 
+/**********************************************************************
+ *          DrawFrame  (USER32.@)
+ *
+ * Private export that XP's common controls 6 call: a frame WIDTH borders
+ * wide along the inside of RECT. The low two bits of FLAGS are unused, bit 2
+ * inverts instead of painting, and the rest is a system colour index times
+ * 8, or 31 * 8 for the 50% grey pattern.
+ */
+BOOL WINAPI DrawFrame( HDC hdc, RECT *rect, int width, int flags )
+{
+    int cx = GetSystemMetrics( SM_CXBORDER ) * width, cy = GetSystemMetrics( SM_CYBORDER ) * width;
+    int w = rect->right - rect->left - cx, h = rect->bottom - rect->top - cy;
+    DWORD rop = (flags & 4) ? PATINVERT : PATCOPY;
+    int color = (flags & ~7) >> 3;
+    HBRUSH brush = color == COLOR_MENUBAR + 1 ? SYSCOLOR_Get55AABrush() : GetSysColorBrush( color );
+    HBRUSH old = SelectObject( hdc, brush );
+
+    PatBlt( hdc, rect->left, rect->top, cx, h, rop );
+    PatBlt( hdc, rect->left + cx, rect->top, w, cy, rop );
+    PatBlt( hdc, rect->left, rect->top + h, w, cy, rop );
+    PatBlt( hdc, rect->left + w, rect->top + cy, cx, h, rop );
+    SelectObject( hdc, old );
+    return TRUE;
+}
+
+
 /**********************************************************************
  *          DrawFrameControl  (USER32.@)
  */
