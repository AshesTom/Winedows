 dlls/gdi32/gdi32.spec   |  4 +--
 dlls/gdi32/text.c       | 12 ++++++++
 dlls/ntdll/ntdll.spec   |  4 +--
 dlls/ntdll/rtlstr.c     | 40 ++++++++++++++++++++++++++
 dlls/user32/lstr.c      | 74 +++++++++++++++++++++++++++++++++++++++++++++++++
 dlls/user32/uitools.c   | 26 +++++++++++++++++
 dlls/user32/user32.spec |  6 ++--
 8 files changed, 171 insertions(+), 7 deletions(-)

