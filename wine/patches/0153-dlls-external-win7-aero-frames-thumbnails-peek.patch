+/* dwmapi makes the frame glass (and the window's surface keep its alpha).
+ * Only the borders and the caption are glass, as under the DWM: the menu bar
+ * and the window's scroll bars, drawn by GDI in the non-client area, stay
+ * opaque. winex11 reads how far the glass goes from each edge of the window
+ * ("__win4wine_glass_frame": left | top << 16, "__win4wine_glass_frame2":
+ * right | bottom << 16). */
+static void make_frame_glass(HWND hwnd, int left, int top, int right, int bottom)
+{
+    static HRESULT (WINAPI *extend)(HWND, const MARGINS *);
+    static const MARGINS none;
+    ULONG_PTR left_top = (left & 0xffff) | (top & 0xffff) << 16, right_bottom = (right & 0xffff) | (bottom & 0xffff) << 16;
+    HMODULE dwmapi;
+
+    if ((ULONG_PTR)GetPropW(hwnd, L"__win4wine_glass_frame") == left_top &&
+        (ULONG_PTR)GetPropW(hwnd, L"__win4wine_glass_frame2") == right_bottom)
+        return;
+    SetPropW(hwnd, L"__win4wine_glass_frame", (HANDLE)left_top);
+    SetPropW(hwnd, L"__win4wine_glass_frame2", (HANDLE)right_bottom);
+    if (!extend && (dwmapi = LoadLibraryW(L"dwmapi.dll")))
+        extend = (void *)GetProcAddress(dwmapi, "DwmExtendFrameIntoClientArea");
+    /* glass, and a new surface for the new insets */
+    if (extend) extend(hwnd, &none);
+    SetWindowPos(hwnd, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+                 SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+}
