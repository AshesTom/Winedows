+/* win4wine: thumbnails (DwmRegisterThumbnail). The table is this process's,
+ * as the DWM keeps them for the destination window; winex11, in the same
+ * process, reads it (the destination's "__win4wine_thumbnails" property)
+ * and draws each source window's X window scaled into the destination's
+ * surface. A thread has them drawn again while visible: live. The layout is
+ * shared with winex11's bitblt.c. */
+struct win4wine_thumbnail
+{
+    HWND dest, src;
+    RECT dest_rect, source_rect;
+    BOOL has_source_rect, visible, client_only;
+    BYTE opacity;
+};
+
+static struct win4wine_thumbnail thumbnails[32];
+static CRITICAL_SECTION thumbnails_section;
+static CRITICAL_SECTION_DEBUG thumbnails_section_debug =
+{
+    0, 0, &thumbnails_section,
+    { &thumbnails_section_debug.ProcessLocksList, &thumbnails_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": thumbnails_section") }
+};
+static CRITICAL_SECTION thumbnails_section = { &thumbnails_section_debug, -1, 0, 0, 0, 0 };
+
+static struct win4wine_thumbnail *find_thumbnail(HTHUMBNAIL thumbnail)
+{
+    ULONG_PTR i = (ULONG_PTR)thumbnail;
+
+    if (!i || i > ARRAY_SIZE(thumbnails) || !thumbnails[i - 1].dest) return NULL;
+    return &thumbnails[i - 1];
+}
+
+static DWORD WINAPI thumbnail_thread(void *arg)
+{
+    for (;;)
+    {
+        int i;
+
+        Sleep(250);
+        for (i = 0; i < ARRAY_SIZE(thumbnails); i++)
+        {
+            HWND dest;
+            RECT rect;
+
+            EnterCriticalSection(&thumbnails_section);
+            dest = thumbnails[i].visible ? thumbnails[i].dest : NULL;
+            rect = thumbnails[i].dest_rect;
+            LeaveCriticalSection(&thumbnails_section);
+            if (dest && IsWindowVisible(dest))
+                RedrawWindow(dest, &rect, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN);
+        }
+    }
+    return 0;
+}
+
+static void start_thumbnail_thread(void)
+{
+    static LONG started;
+    HANDLE thread;
+
+    if (InterlockedExchange(&started, 1)) return;
+    if ((thread = CreateThread(NULL, 0, thumbnail_thread, NULL, 0, NULL))) CloseHandle(thread);
+}
+
+/**********************************************************************
+ *           DwmQueryThumbnailSourceSize         (DWMAPI.@)
+ */
+HRESULT WINAPI DwmQueryThumbnailSourceSize(HTHUMBNAIL thumbnail, SIZE *size)
+{
+    struct win4wine_thumbnail *entry;
+    RECT rect;
+
+    TRACE("(%p, %p)\n", thumbnail, size);
+
+    if (!size)
+        return E_INVALIDARG;
+    if (!(entry = find_thumbnail(thumbnail)))
+        return E_INVALIDARG;
+    if (entry->client_only) GetClientRect(entry->src, &rect);
+    else GetWindowRect(entry->src, &rect);
+    size->cx = rect.right - rect.left;
+    size->cy = rect.bottom - rect.top;
+    return S_OK;
+}
+
 /**********************************************************************
  *           DwmUnregisterThumbnail         (DWMAPI.@)
  */
 HRESULT WINAPI DwmUnregisterThumbnail(HTHUMBNAIL thumbnail)
 {
-    FIXME("(%p) stub\n", thumbnail);
+    struct win4wine_thumbnail *entry;
 
-    return E_NOTIMPL;
+    TRACE("(%p)\n", thumbnail);
+
+    if (!(entry = find_thumbnail(thumbnail)))
+        return E_INVALIDARG;
+    EnterCriticalSection(&thumbnails_section);
+    entry->dest = NULL;
+    entry->visible = FALSE;
+    LeaveCriticalSection(&thumbnails_section);
+    return S_OK;
 }
 
