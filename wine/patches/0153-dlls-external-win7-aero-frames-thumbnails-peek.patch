+        static const int parts[3] = { 7, 5, 3 };
+        BOOL zoomed = IsZoomed(hwnd) || !!GetPropW(hwnd, L"Win4WineMaximized");
+        int glow = MulDiv(2, dpi, 96), widths[3];
+
+        height = GetSystemMetrics(SM_CYSIZE) - 1;
+        for (i = 0; i < 3; i++)
+        {
+            RECT image;
+            if (dwm && SUCCEEDED(GetThemeRect(dwm, parts[i], 0, TMT_ATLASRECT, &image)) && image.bottom - image.top >= 8)
