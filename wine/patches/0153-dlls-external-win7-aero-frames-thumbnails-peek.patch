+/* A premultiplied ARGB color over RECT, keeping the alpha of a 32-bit DIB */
+static void fill_premultiplied(HDC dc, const RECT *rect, DWORD argb)
+{
+    static const BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    BITMAPINFO info = {{ sizeof(info.bmiHeader), 1, -1, 1, 32 }};
+    UINT a = argb >> 24;
+    DWORD *bits;
+    HBITMAP bitmap;
+    HDC mem;
+
+    if (IsRectEmpty(rect) || !(mem = CreateCompatibleDC(dc))) return;
+    if ((bitmap = CreateDIBSection(mem, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0)))
+    {
+        *bits = (a << 24) | ((((argb >> 16) & 0xff) * a / 255) << 16) | ((((argb >> 8) & 0xff) * a / 255) << 8) |
+                ((argb & 0xff) * a / 255);
+        SelectObject(mem, bitmap);
+        GdiAlphaBlend(dc, rect->left, rect->top, rect->right - rect->left, rect->bottom - rect->top,
+                      mem, 0, 0, 1, 1, blend);
+        DeleteObject(bitmap);
+    }
+    DeleteDC(mem);
+}
+
+/* The edges of a glass frame: a dark line outside, a light one along the
+ * client area */
+static void draw_glass_edges(HDC dc, const RECT *window, const RECT *client, BOOL active)
+{
+    DWORD outer = active ? 0x99000000 : 0x66000000, inner = active ? 0x80ffffff : 0x50ffffff;
+    RECT line;
+
+    SetRect(&line, window->left, window->top, window->right, window->top + 1); fill_premultiplied(dc, &line, outer);
+    SetRect(&line, window->left, window->bottom - 1, window->right, window->bottom); fill_premultiplied(dc, &line, outer);
+    SetRect(&line, window->left, window->top + 1, window->left + 1, window->bottom - 1); fill_premultiplied(dc, &line, outer);
+    SetRect(&line, window->right - 1, window->top + 1, window->right, window->bottom - 1); fill_premultiplied(dc, &line, outer);
+    SetRect(&line, window->left + 1, window->top + 1, window->right - 1, window->top + 2); fill_premultiplied(dc, &line, inner);
+    SetRect(&line, client->left - 1, client->top - 1, client->right + 1, client->top); fill_premultiplied(dc, &line, inner);
+    SetRect(&line, client->left - 1, client->bottom, client->right + 1, client->bottom + 1); fill_premultiplied(dc, &line, inner);
+    SetRect(&line, client->left - 1, client->top, client->left, client->bottom); fill_premultiplied(dc, &line, inner);
+    SetRect(&line, client->right, client->top, client->right + 1, client->bottom); fill_premultiplied(dc, &line, inner);
+}
