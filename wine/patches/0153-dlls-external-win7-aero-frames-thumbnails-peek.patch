+    if (aero_frames())
+    {
+        /* Aero's buttons, as the DWM places them: one group against the top
+         * of the frame, as high as the caption buttons' metric less one
+         * (CaptionHeight, SM_CYSIZE: 21 in Windows 7's WindowMetrics, so 20),
