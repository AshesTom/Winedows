+/* win4wine: Aero Peek. While a window is previewed, the other top-level
+ * windows are made transparent with _NET_WM_WINDOW_OPACITY (winex11's
+ * escape, on their X windows), which the session's X compositor follows. */
+#define X11DRV_ESCAPE 6789
+struct win4wine_opacity_escape
+{
+    int code;          /* X11DRV_WIN4WINE_OPACITY (winex11's x11drv.h) */
+    UINT64 window;
+    UINT opacity;
+    UINT remove;
+};
+
+static HWND peek_hidden[256];
+static UINT peek_count;
+static HWND peek_window, peek_topmost;
+
+static void set_x11_opacity(HWND hwnd, BOOL transparent)
+{
+    struct win4wine_opacity_escape escape = { 4 /* X11DRV_WIN4WINE_OPACITY */ };
+    HDC hdc;
+
+    if (!(escape.window = (UINT_PTR)GetPropW(hwnd, L"__wine_x11_whole_window"))) return;
+    escape.opacity = 0;
+    escape.remove = !transparent;
+    if ((hdc = CreateDCW(L"DISPLAY", NULL, NULL, NULL)))
+    {
+        ExtEscape(hdc, X11DRV_ESCAPE, sizeof(escape), (const char *)&escape, 0, NULL);
+        DeleteDC(hdc);
+    }
+}
+
+static BOOL CALLBACK peek_hide(HWND hwnd, LPARAM lparam)
+{
+    WCHAR class[64];
+
+    if (hwnd == peek_window || hwnd == peek_topmost || !IsWindowVisible(hwnd) || IsIconic(hwnd)) return TRUE;
+    /* the shell stays: its taskbar, the thumbnails, the desktop */
+    if (GetClassNameW(hwnd, class, ARRAY_SIZE(class)) &&
+        (!wcscmp(class, L"Shell_TrayWnd") || !wcscmp(class, L"TaskListThumbnailWnd") ||
+         !wcscmp(class, L"Progman") || !wcscmp(class, L"WorkerW") || !wcscmp(class, L"#32769") ||
+         !wcscmp(class, L"Shell_SecondaryTrayWnd")))
+        return TRUE;
+    if (GetWindow(hwnd, GW_OWNER) == peek_topmost && peek_topmost) return TRUE;
+    if (peek_count == ARRAY_SIZE(peek_hidden)) return FALSE;
+    peek_hidden[peek_count++] = hwnd;
+    set_x11_opacity(hwnd, TRUE);
+    return TRUE;
+}
+
+static void end_peek(void)
+{
+    while (peek_count) set_x11_opacity(peek_hidden[--peek_count], FALSE);
+}
+
 /**********************************************************************
  *           DwmpActivateLivePreview         (DWMAPI.113)
  *
- * Windows 7's taskbar calls it (for example when the task list opens) to
- * start or end a window preview. There is no desktop composition here, so
- * there is no preview. Its arguments have no public description; on 64-bit
- * the caller passes them in registers and removes them itself, so returning
- * without reading them is safe.
+ * Windows 7's taskbar calls it to start (PEEK nonzero, for WINDOW, or the
+ * desktop for the Show desktop button) or end Aero Peek; TOPMOST stays
+ * shown above (the taskbar). With Aero the other windows become
+ * transparent; without composition there is no preview. 64-bit only: its
+ * 32-bit form has another layout.
  */
-HRESULT WINAPI DwmpActivateLivePreview(void)
+HRESULT WINAPI DwmpActivateLivePreview(UINT peek, HWND window, HWND topmost, UINT type)
 {
-    TRACE( "\n" );
+    BOOL enabled = FALSE;
+
+    TRACE( "%u %p %p %u\n", peek, window, topmost, type );
+    end_peek();
+    if (!peek || DwmIsCompositionEnabled(&enabled) != S_OK || !enabled) return S_OK;
+    peek_window = window;
+    peek_topmost = topmost;
+    EnumWindows(peek_hide, 0);
     return S_OK;
 }
 
@@ -556,12 +833,11 @@
  *           DwmpRegisterThumbnail         (DWMAPI.124)
  *
  * Windows 7's taskbar calls it for the thumbnail of a window when a button
- * is pointed at or clicked. Without desktop composition there is no
- * thumbnail; DwmRegisterThumbnail fails the same way. Its arguments have no
- * public description and are not read (see DwmpActivateLivePreview).
+ * is pointed at: (destination, source, NULL, 1, &thumbnail) as logged from
+ * its explorer, the private form of DwmRegisterThumbnail. 64-bit only.
  */
-HRESULT WINAPI DwmpRegisterThumbnail(void)
+HRESULT WINAPI DwmpRegisterThumbnail(HWND dest, HWND src, const void *unknown, UINT_PTR flags, PHTHUMBNAIL thumbnail)
 {
-    TRACE( "\n" );
-    return E_NOTIMPL;
+    TRACE( "%p %p %p %Ix %p\n", dest, src, unknown, flags, thumbnail );
+    return DwmRegisterThumbnail(dest, src, thumbnail);
 }
