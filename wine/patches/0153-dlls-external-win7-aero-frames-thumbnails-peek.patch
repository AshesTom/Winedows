+static void glass_opaque_rect( HWND hwnd, const RECT *surface_rect, RECT *opaque, POINT *client )
+{
+#define PROP(name) static const WCHAR name##_prop[] = {'_','_','w','i','n','4','w','i','n','e','_','g','l','a','s','s','_'
+    PROP(frame), 'f','r','a','m','e',0};
+    PROP(frame2), 'f','r','a','m','e','2',0};
+    PROP(margins), 'm','a','r','g','i','n','s',0};
+    PROP(margins2), 'm','a','r','g','i','n','s','2',0};
+    PROP(sheet), 's','h','e','e','t',0};
+#undef PROP
+    struct x11drv_win_data *data;
+    ULONG_PTR frame, frame2, margins, margins2;
+    RECT window;
+
+    SetRectEmpty( opaque );
+    client->x = client->y = 0;
+    if (!(data = get_win_data( hwnd ))) return;
+    *opaque = data->rects.client;
+    window = data->rects.window;
+    OffsetRect( opaque, -data->rects.visible.left - surface_rect->left, -data->rects.visible.top - surface_rect->top );
+    OffsetRect( &window, -data->rects.visible.left - surface_rect->left, -data->rects.visible.top - surface_rect->top );
+    release_win_data( data );
+    client->x = opaque->left;
+    client->y = opaque->top;
+    frame = (ULONG_PTR)NtUserGetProp( hwnd, frame_prop );
+    frame2 = (ULONG_PTR)NtUserGetProp( hwnd, frame2_prop );
+    margins = (ULONG_PTR)NtUserGetProp( hwnd, margins_prop );
+    margins2 = (ULONG_PTR)NtUserGetProp( hwnd, margins2_prop );
+    if (!frame || NtUserGetProp( hwnd, sheet_prop ))
