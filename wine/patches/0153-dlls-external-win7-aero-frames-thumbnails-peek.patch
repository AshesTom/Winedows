+/* winex11 puts the colorization color and the reflection under the pixels
+ * of a glass window */
+static void set_glass(HWND hwnd, BOOL glass)
+{
+    if (glass)
+    {
+        HBITMAP reflection = glass_reflection();
+
+        if (reflection) SetPropW(hwnd, L"__win4wine_glass_reflection", reflection);
+        SetPropW(hwnd, L"__win4wine_glass", (HANDLE)(ULONG_PTR)(colorization_color() | !colorization_color()));
+    }
+    else RemovePropW(hwnd, L"__win4wine_glass");
+}
