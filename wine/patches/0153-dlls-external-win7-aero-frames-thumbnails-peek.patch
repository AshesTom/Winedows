@@ -391,9 +538,39 @@
  */
 HRESULT WINAPI DwmRegisterThumbnail(HWND dest, HWND src, PHTHUMBNAIL thumbnail_id)
 {
-    FIXME("(%p %p %p) stub\n", dest, src, thumbnail_id);
+    BOOL enabled = FALSE;
+    int i;
 
-    return E_NOTIMPL;
+    TRACE("(%p %p %p)\n", dest, src, thumbnail_id);
+
+    if (!thumbnail_id)
+        return E_INVALIDARG;
+    if (DwmIsCompositionEnabled(&enabled) != S_OK || !enabled)
+        return DWM_E_COMPOSITIONDISABLED;
+    if (!IsWindow(dest) || !IsWindow(src) || GetWindowThreadProcessId(dest, NULL) == 0)
+        return E_INVALIDARG;
+    EnterCriticalSection(&thumbnails_section);
+    for (i = 0; i < ARRAY_SIZE(thumbnails); i++)
+        if (!thumbnails[i].dest) break;
+    if (i == ARRAY_SIZE(thumbnails))
+    {
+        LeaveCriticalSection(&thumbnails_section);
+        return E_OUTOFMEMORY;
+    }
+    memset(&thumbnails[i], 0, sizeof(thumbnails[i]));
+    thumbnails[i].src = src;
+    thumbnails[i].opacity = 255;
+    thumbnails[i].visible = TRUE; /* as on Windows: Windows 7's taskbar never sets it */
+    thumbnails[i].dest = dest;
+    LeaveCriticalSection(&thumbnails_section);
+    /* winex11 draws the thumbnails of the window's process into it (its
+     * layout is the 64-bit one: Windows 7's taskbar) */
+#ifdef _WIN64
+    SetPropW(dest, L"__win4wine_thumbnails", thumbnails);
+#endif
+    *thumbnail_id = (HTHUMBNAIL)(ULONG_PTR)(i + 1);
+    start_thumbnail_thread();
+    return S_OK;
 }
 
