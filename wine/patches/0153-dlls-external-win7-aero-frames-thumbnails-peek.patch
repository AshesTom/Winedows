+/* An Aero caption button: the DWMWindow atlas's background for the button
+ * (minimize, maximize: 3 and 5, close: 7, close alone: 9; one more when
+ * inactive) and its white glyph at the window's DPI (close 12, help 17,
+ * maximize 21, minimize 25, restore 29, then 120, 144 and 192 DPI). Rows:
+ * normal, hot, pressed, disabled. */
+static BOOL draw_aero_button(HDC dc, HWND hwnd, int part, int state, const RECT *rect, BOOL active, BOOL alone)
+{
+    HTHEME dwm = OpenThemeData(NULL, L"DWMWindow");
+    UINT dpi = GetDpiForWindow(hwnd);
+    int row = (state - 1) % 4, background, glyph, size = dpi >= 192 ? 3 : dpi >= 144 ? 2 : dpi >= 120 ? 1 : 0;
+    RECT glow;
+    BOOL ret;
+
+    switch (part)
+    {
+    case WP_CLOSEBUTTON: background = alone ? 9 : 7; glyph = 12; break;
+    case WP_HELPBUTTON: background = 5; glyph = 17; break;
+    case WP_MAXBUTTON: background = 5; glyph = 21; break;
+    case WP_RESTOREBUTTON: background = 5; glyph = 29; break;
+    case WP_MINBUTTON: background = 3; glyph = 25; break;
+    default: CloseThemeData(dwm); return FALSE;
+    }
+    if (!active && row == 0) background++;
+    /* the images' glow goes 2 pixels out of the button (1 above and below) */
+    glow = *rect;
+    InflateRect(&glow, MulDiv(2, dpi, 96), MulDiv(1, dpi, 96));
+    ret = draw_atlas_part(dc, dwm, background, row, 4, &glow, FALSE);
+    if (ret) draw_atlas_part(dc, dwm, glyph + size, row == 3 ? 3 : 0, 4, rect, TRUE);
+    CloseThemeData(dwm);
+    return ret;
+}
