 HRESULT WINAPI DwmExtendFrameIntoClientArea(HWND hwnd, const MARGINS* margins)
 {
-    FIXME("(%p, %p) stub\n", hwnd, margins);
+    BOOL enabled = FALSE, sheet;
+    ULONG_PTR left_right, top_bottom;
+
+    TRACE("(%p, %p)\n", hwnd, margins);
 
+    if (!margins)
+        return E_INVALIDARG;
+    if (DwmIsCompositionEnabled(&enabled) != S_OK || !enabled)
+        return DWM_E_COMPOSITIONDISABLED;
+    if (!IsWindow(hwnd))
+        return E_HANDLE;
+    /* win4wine: the glass frame (uxtheme, winex11) goes this far into the
+     * client area ("__win4wine_glass_margins": left | right << 16,
+     * "__win4wine_glass_margins2": top | bottom << 16), the whole of it
+     * with a negative margin ("__win4wine_glass_sheet"). */
+    sheet = margins->cxLeftWidth < 0 || margins->cxRightWidth < 0 || margins->cyTopHeight < 0 ||
+            margins->cyBottomHeight < 0;
+    if (sheet) left_right = top_bottom = 0;
+    else
+    {
+        left_right = min(margins->cxLeftWidth, 0xffff) | min(margins->cxRightWidth, 0xffff) << 16;
+        top_bottom = min(margins->cyTopHeight, 0xffff) | min(margins->cyBottomHeight, 0xffff) << 16;
+    }
+    /* As under the DWM, the frame itself is glass (uxtheme draws it so and
+     * says how far it goes: "__win4wine_glass_frame") */
+    if (GetPropW(hwnd, L"__win4wine_glass") && !GetPropW(hwnd, L"__win4wine_glass_sheet") == !sheet &&
+        (ULONG_PTR)GetPropW(hwnd, L"__win4wine_glass_margins") == left_right &&
+        (ULONG_PTR)GetPropW(hwnd, L"__win4wine_glass_margins2") == top_bottom)
+        return S_OK;
+    set_glass(hwnd, TRUE);
+    if (sheet) SetPropW(hwnd, L"__win4wine_glass_sheet", (HANDLE)1);
+    else RemovePropW(hwnd, L"__win4wine_glass_sheet");
+    SetPropW(hwnd, L"__win4wine_glass_margins", (HANDLE)left_right);
+    SetPropW(hwnd, L"__win4wine_glass_margins2", (HANDLE)top_bottom);
+    glass_changed(hwnd);
     return S_OK;
 }
 
