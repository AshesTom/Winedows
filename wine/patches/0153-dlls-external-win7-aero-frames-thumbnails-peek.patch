+/* Row ROW of ROWS of a DWMWindow atlas part over DEST, stretched by its
+ * sizing margins (or at its own size, centred, when CENTRED) */
+static BOOL draw_atlas_part(HDC dc, HTHEME dwm, int part, int row, int rows, const RECT *dest, BOOL centred)
+{
+    static const BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    HDC atlas = aero_atlas();
+    MARGINS m = {0};
+    RECT src;
+    int w, h, x[4], y[4], sx[4], sy[4], i, j;
+
+    if (!atlas || !dwm || FAILED(GetThemeRect(dwm, part, 0, TMT_ATLASRECT, &src)) || IsRectEmpty(&src))
+        return FALSE;
+    h = (src.bottom - src.top) / rows;
+    src.top += row * h;
+    src.bottom = src.top + h;
+    w = src.right - src.left;
+    if (centred)
+    {
+        int left = (dest->left + dest->right - w) / 2, top = (dest->top + dest->bottom - h) / 2;
+        return GdiAlphaBlend(dc, left, top, w, h, atlas, src.left, src.top, w, h, blend);
+    }
+    GetThemeMargins(dwm, NULL, part, 0, TMT_SIZINGMARGINS, NULL, &m);
+    m.cxLeftWidth = min(m.cxLeftWidth, w / 2);
+    m.cxRightWidth = min(m.cxRightWidth, w / 2);
+    m.cyTopHeight = min(m.cyTopHeight, h / 2);
+    m.cyBottomHeight = min(m.cyBottomHeight, h / 2);
+    x[0] = dest->left; x[1] = dest->left + m.cxLeftWidth; x[2] = dest->right - m.cxRightWidth; x[3] = dest->right;
+    y[0] = dest->top; y[1] = dest->top + m.cyTopHeight; y[2] = dest->bottom - m.cyBottomHeight; y[3] = dest->bottom;
+    sx[0] = src.left; sx[1] = src.left + m.cxLeftWidth; sx[2] = src.right - m.cxRightWidth; sx[3] = src.right;
+    sy[0] = src.top; sy[1] = src.top + m.cyTopHeight; sy[2] = src.bottom - m.cyBottomHeight; sy[3] = src.bottom;
+    for (j = 0; j < 3; j++)
+        for (i = 0; i < 3; i++)
+            if (x[i + 1] > x[i] && y[j + 1] > y[j] && sx[i + 1] > sx[i] && sy[j + 1] > sy[j])
+                GdiAlphaBlend(dc, x[i], y[j], x[i + 1] - x[i], y[j + 1] - y[j],
+                              atlas, sx[i], sy[j], sx[i + 1] - sx[i], sy[j + 1] - sy[j], blend);
+    return TRUE;
+}
