@@ -497,8 +674,47 @@
  */
 HRESULT WINAPI DwmUpdateThumbnailProperties(HTHUMBNAIL thumbnail, const DWM_THUMBNAIL_PROPERTIES *props)
 {
-    FIXME("(%p, %p) stub\n", thumbnail, props);
-    return E_NOTIMPL;
+    struct win4wine_thumbnail *entry;
+    RECT old;
+
+    TRACE("(%p, %p)\n", thumbnail, props);
+
+    if (!props)
+        return E_INVALIDARG;
+    TRACE("flags %#lx visible %d opacity %u client only %d\n", props->dwFlags, props->fVisible, props->opacity,
+          props->fSourceClientAreaOnly);
+    if (!(entry = find_thumbnail(thumbnail)))
+        return E_INVALIDARG;
+    EnterCriticalSection(&thumbnails_section);
+    old = entry->dest_rect;
+    if (props->dwFlags & DWM_TNP_RECTDESTINATION) entry->dest_rect = props->rcDestination;
+    if (props->dwFlags & DWM_TNP_RECTSOURCE)
+    {
+        entry->source_rect = props->rcSource;
+        entry->has_source_rect = TRUE;
+    }
+    if (props->dwFlags & DWM_TNP_OPACITY) entry->opacity = props->opacity;
+    if (props->dwFlags & DWM_TNP_VISIBLE) entry->visible = props->fVisible;
+    if (props->dwFlags & DWM_TNP_SOURCECLIENTAREAONLY) entry->client_only = props->fSourceClientAreaOnly;
+    if (entry->client_only && !(props->dwFlags & DWM_TNP_RECTSOURCE))
+    {
+        /* the client area, in the source window's (its X window's) coordinates */
+        RECT window, client;
+        POINT origin = {0, 0};
+
+        GetWindowRect(entry->src, &window);
+        GetClientRect(entry->src, &client);
+        ClientToScreen(entry->src, &origin);
+        OffsetRect(&client, origin.x - window.left, origin.y - window.top);
+        entry->source_rect = client;
+        entry->has_source_rect = TRUE;
+    }
+    LeaveCriticalSection(&thumbnails_section);
+    TRACE("dest %p src %p %s visible %d opacity %u\n", entry->dest, entry->src,
+          wine_dbgstr_rect(&entry->dest_rect), entry->visible, entry->opacity);
+    RedrawWindow(entry->dest, &old, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN);
+    RedrawWindow(entry->dest, &entry->dest_rect, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN);
+    return S_OK;
 }
 
