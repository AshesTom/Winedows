From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] win32u: hint standard smoothing with FreeType's v35 interpreter in the XP shell

Purpose: space text drawn with standard font smoothing as XP does; the
desktop icons' labels in Tahoma 8 pt ("My Documents", "Recycle Bin") had
letters 1 pixel too far apart or too close together.
XP behavior: GDI hints text drawn with standard font smoothing like black
and white text, and its advances are the font's hdmx widths: Tahoma at 11
pixels has 'y' 6 pixels wide and 'i' and 'l' 2.
Wine before: with FreeType 2.8.1 or later Wine keeps FreeType's default
v40 interpreter, which for every target but FT_LOAD_TARGET_MONO (that is
GGO_METRICS and grey glyphs) hints vertically only and ignores hdmx: the
advances are the unhinted widths rounded (5, 3 and 3).
Change: in the XP shell, the v35 interpreter while the font smoothing is
standard; with ClearType or without smoothing, FreeType's own (as the
system's FreeType is configured): XP lays out ClearType text with the
black and white advances already (0062), which v40 hints as v35 does.
The interpreter follows a change of the setting (0165) at the next glyph.
Evidence: FreeType 2.15 with Tahoma at 11 pixels, FT_LOAD_TARGET_NORMAL:
v40 gives R e c y c l e B i n advances 7 6 5 5 5 3 6 6 3 6, v35 and the
monochrome target 7 6 5 6 5 2 6 6 2 6, as on XP. In the nested session,
"My Documents" lost its gap after the m; switching to ClearType and back
gave the same labels.
Scope: WIN4WINE_EXTERNAL_SHELL without WIN4WINE_SHELL (the XP shell).
---
diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -4814,6 +4814,12 @@
     init_font_smoothing();
 }
 
+/* Whether the font smoothing setting is the standard (grey) one. */
+BOOL font_smoothing_standard(void)
+{
+    return font_smoothing == GGO_GRAY4_BITMAP;
+}
+
 static UINT init_font_options(void)
 {
     char value_buffer[FIELD_OFFSET(KEY_VALUE_PARTIAL_INFORMATION, Data[20 * sizeof(WCHAR)])];
diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -77,6 +77,9 @@
 WINE_DEFAULT_DEBUG_CHANNEL(font);
 
 static FT_Library library = 0;
+/* The interpreter FreeType chose (0: none to choose), and the one set now. */
+static FT_UInt default_interpreter, current_interpreter;
+static void update_interpreter_version(void);
 typedef struct
 {
     FT_Int major;
@@ -119,6 +122,7 @@
 MAKE_FUNCPTR(FT_Outline_Get_CBox);
 MAKE_FUNCPTR(FT_Outline_Transform);
 MAKE_FUNCPTR(FT_Outline_Translate);
+MAKE_FUNCPTR(FT_Property_Get);
 MAKE_FUNCPTR(FT_Property_Set);
 MAKE_FUNCPTR(FT_Render_Glyph);
 MAKE_FUNCPTR(FT_Set_Charmap);
@@ -1496,6 +1500,7 @@
     LOAD_FUNCPTR(FT_Outline_Get_CBox)
     LOAD_FUNCPTR(FT_Outline_Transform)
     LOAD_FUNCPTR(FT_Outline_Translate)
+    LOAD_FUNCPTR(FT_Property_Get)
     LOAD_FUNCPTR(FT_Property_Set)
     LOAD_FUNCPTR(FT_Render_Glyph)
     LOAD_FUNCPTR(FT_Set_Charmap)
@@ -1524,6 +1529,10 @@
         FT_UInt interpreter_version = 35;
         pFT_Property_Set( library, "truetype", "interpreter-version", &interpreter_version );
     }
+    if (pFT_Property_Get( library, "truetype", "interpreter-version", &default_interpreter ))
+        default_interpreter = 0;
+    current_interpreter = default_interpreter;
+    update_interpreter_version();
 
     pFT_Library_SetLcdFilter( library, FT_LCD_FILTER_DEFAULT );
 
@@ -3194,6 +3203,29 @@
     return load_flags;
 }
 
+/*************************************************************
+ * update_interpreter_version
+ *
+ * XP hints text drawn with standard font smoothing like black and white
+ * text, with the font's hdmx widths: FreeType's v35 TrueType interpreter.
+ * v40 (the default since FreeType 2.7) hints it vertically only, so
+ * Tahoma at 11 pixels has 'y' 5 pixels wide instead of 6 and 'i' and 'l'
+ * 3 instead of 2. With ClearType or without smoothing, the system's own
+ * interpreter stays (ClearType text is laid out with the black and white
+ * advances, which v40 hints as v35 does). The setting may change while the
+ * process runs (Display Properties); the font lock is held.
+ */
+static void update_interpreter_version(void)
+{
+    FT_UInt wanted = default_interpreter;
+
+    if (!wanted) return;  /* FreeType without the property */
+    if (win4wine_shell() == WIN4WINE_SHELL_XP && font_smoothing_standard()) wanted = 35;
+    if (wanted == current_interpreter) return;
+    if (!pFT_Property_Set( library, "truetype", "interpreter-version", &wanted ))
+        current_interpreter = wanted;
+}
+
 /*************************************************************
  * freetype_get_glyph_outline
  */
@@ -3212,6 +3244,8 @@
 
     TRACE("%p, %04x, %08x, %p, %08x, %p, %p\n", font, glyph, format, lpgm, buflen, buf, lpmat);
 
+    update_interpreter_version();
+
     TRACE("font transform %f %f %f %f\n",
           font->matrix.eM11, font->matrix.eM12,
           font->matrix.eM21, font->matrix.eM22);
diff --git a/dlls/win32u/ntgdi_private.h b/dlls/win32u/ntgdi_private.h
--- a/dlls/win32u/ntgdi_private.h
+++ b/dlls/win32u/ntgdi_private.h
@@ -347,6 +347,7 @@
                          const struct bitmap_font_size *size );
 extern UINT font_init(void);
 extern BOOL font_external_cleartype(void);
+extern BOOL font_smoothing_standard(void);
 extern const struct font_backend_funcs *init_freetype_lib(void);
 
 /* opentype.c */
