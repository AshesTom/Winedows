From: Codex <codex@localhost>
Subject: [PATCH] user32: play XP AppEvents sounds for message boxes

The XP shell expects MessageBox to play the system sound associated with its
icon. Wine's current MessageBeep path only asks the Unix driver for a generic
beep, so the imported XP AppEvents aliases are skipped.

For the XP external shell, resolve PlaySoundW dynamically and play the normal
SystemHand/SystemQuestion/SystemExclamation/SystemAsterisk/SystemDefault alias.
Dynamic lookup avoids a user32 -> winmm import cycle because winmm imports
user32.
---
 dlls/user32/msgbox.c | 42 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/dlls/user32/msgbox.c b/dlls/user32/msgbox.c
--- a/dlls/user32/msgbox.c
+++ b/dlls/user32/msgbox.c
@@ -27,6 +27,7 @@
 #include "winbase.h"
 #include "wingdi.h"
 #include "winternl.h"
+#include "mmsystem.h"
 #include "dlgs.h"
 #include "user_private.h"
 #include "wine/win4wine.h"
@@ -36,6 +37,46 @@
 WINE_DEFAULT_DEBUG_CHANNEL(dialog);
 WINE_DECLARE_DEBUG_CHANNEL(msgbox);
 
+/* XP message boxes play the configured AppEvents sound that corresponds to
+ * their icon.  Wine's MessageBeep currently only asks the Unix driver for a
+ * generic beep, so the native XP shell never reaches the imported XP sound
+ * scheme.  Resolve PlaySoundW dynamically to avoid a user32 -> winmm import
+ * cycle (winmm already imports user32). */
+static void MSGBOX_PlayXPSound( UINT style )
+{
+    static HMODULE winmm;
+    static BOOL (WINAPI *play_sound)( LPCWSTR, HMODULE, DWORD );
+    LPCWSTR alias;
+
+    if (win4wine_shell() != WIN4WINE_SHELL_XP) return;
+
+    switch (style & MB_ICONMASK)
+    {
+    case MB_ICONHAND:
+        alias = L"SystemHand";
+        break;
+    case MB_ICONQUESTION:
+        alias = L"SystemQuestion";
+        break;
+    case MB_ICONEXCLAMATION:
+        alias = L"SystemExclamation";
+        break;
+    case MB_ICONASTERISK:
+        alias = L"SystemAsterisk";
+        break;
+    default:
+        alias = L"SystemDefault";
+        break;
+    }
+
+    if (!play_sound)
+    {
+        if (!winmm) winmm = LoadLibraryW( L"winmm.dll" );
+        if (winmm) play_sound = (void *)GetProcAddress( winmm, "PlaySoundW" );
+    }
+    if (play_sound) play_sound( alias, NULL, SND_ALIAS | SND_ASYNC | SND_NODEFAULT );
+}
+
 struct ThreadWindows
 {
     UINT numHandles;
@@ -546,6 +587,7 @@ static INT_PTR CALLBACK MSGBOX_DlgProc( HWND hwnd, UINT message,
        LPMSGBOXPARAMSW mbp = (LPMSGBOXPARAMSW)lParam;
        NtUserSetWindowContextHelpId(hwnd, mbp->dwContextHelpId);
        MSGBOX_OnInit(hwnd, mbp);
+       MSGBOX_PlayXPSound( mbp->dwStyle );
        SetPropA(hwnd, "WINE_MSGBOX_HELPCALLBACK", mbp->lpfnMsgBoxCallback);
        break;
    }
