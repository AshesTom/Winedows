From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] user32: theme the shell's controls when XP's comctl32 is beside the program

Purpose: draw Luna buttons, edits and combo boxes in XP's Display Properties
(rundll32 running desk.cpl and themeui.dll).
Wine before (with win4wine patch 0067): the shell's controls are themed only when the
first comctl32 module of the process is native. themeui's manifest also
loads Wine's common controls 6, so the check failed and the buttons stayed
classic although XP's comctl32 was loaded from beside rundll32.
Change: also accept XP's comctl32 loaded from the executable's folder.
Scope: only with WIN4WINE_EXTERNAL_SHELL, as win4wine patch 0067.
---
 dlls/user32/class.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/dlls/user32/class.c b/dlls/user32/class.c
index 863d49f..3499b2f 100644
--- a/dlls/user32/class.c
+++ b/dlls/user32/class.c
@@ -372,10 +372,21 @@ const WCHAR *external_shell_control_class( const WCHAR *name )
     for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcsicmp( name, names[i] )) break;
     if (i == ARRAY_SIZE(names)) return NULL;
     if (ReadAcquire( &registered[i] )) return classes[i];
-    /* Only where comctl32 is the native one; Wine's own finds its classes itself. */
+    /* Only where XP's comctl32 is loaded; Wine's own finds its classes itself.
+     * A shell process such as rundll32 running XP's Display Properties may
+     * also have Wine's copy, requested by a module's manifest: XP's copy
+     * beside the executable (Wine patch 0016) still counts. */
     if (!(comctl32 = GetModuleHandleW( L"comctl32.dll" )) ||
         !memcmp( (IMAGE_DOS_HEADER *)comctl32 + 1, signature, sizeof(signature) ))
-        return NULL;
+    {
+        WCHAR path[MAX_PATH], *slash;
+        DWORD length = GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) - 13 );
+        if (!length || length >= ARRAY_SIZE(path) - 13 || !(slash = wcsrchr( path, '\\' ))) return NULL;
+        lstrcpyW( slash + 1, L"comctl32.dll" );
+        if (!(comctl32 = GetModuleHandleW( path )) ||
+            !memcmp( (IMAGE_DOS_HEADER *)comctl32 + 1, signature, sizeof(signature) ))
+            return NULL;
+    }
     if (!(controls = LoadLibraryW( L"win4wine-controls.dll" ))) return NULL;
     register_control = (void *)GetProcAddress( controls, "Win4WineRegisterControl" );
     lstrcpyW( plain, L"Win4Wine" );
